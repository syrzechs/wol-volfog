+// Not in the original client (World of Legends): wolUiDepth, see patches-cliente/ui-depth/README-uidepth.md. 0 (default)
+// is the original; 1 makes the 2D interface write depth 0.0 so that post-processing (ReShade) leaves it alone. Read
+// every frame by CSimpleRender::DrawBatch through g_wolUiDepth, so it applies at once.
+CVar* g_wolUiDepthCVar;
+
+static bool CVarHandler_wolUiDepth(CVar* var, const char* oldValue, const char* value, void* arg) {
+    if (!value || (value[0] != '0' && value[0] != '1') || value[1]) {
+        ConsoleWriteA("wolUiDepth must be 0 (original) or 1.\n", DEFAULT_COLOR);
+        return false;
+    }
+
+    g_wolUiDepth = value[0] == '1';
+
+    // No message while the CVar is first registered (no previous value).
+    if (oldValue && *oldValue) {
+        ConsoleWriteA("wolUiDepth: %s\n", DEFAULT_COLOR, g_wolUiDepth ? "on (the interface writes depth 0.0)" : "off (original)");
+    }
+
+    return true;
+}
