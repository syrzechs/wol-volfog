 }
 
+// Not in the original client (World of Legends): wolUiDepth (0 = original). ReShade runs after the interface is drawn
+// and reads the depth buffer; the interface never wrote to it, so the depth of the world stayed under every UI pixel.
+// With wolUiDepth 1 every visible texel of the 2D interface writes depth 0.0 (the near plane) and nothing else changes.
+int32_t g_wolUiDepth;
+
+// Nonzero while CSimpleRender::DrawBatch draws textures and text (between WOLUIDEPTH::Enter and Leave). The text batches
+// of the world, the models and the render callbacks are drawn outside of it.
+static int32_t s_wolUiDepthScope;
+
+// Texels below this alpha do not write depth (the original alpha test of the Alpha and Add blends is 1 of 255).
+#define WOL_UI_DEPTH_ALPHA_REF 16
+
+WOLUIDEPTH::~WOLUIDEPTH() {
+    this->ZEnd();
+    this->Leave();
+}
+
+void WOLUIDEPTH::Enter() {
+    if (g_wolUiDepth && !this->m_scoped) {
+        this->m_scoped = 1;
+        s_wolUiDepthScope++;
+    }
+}
+
+void WOLUIDEPTH::Leave() {
+    if (this->m_scoped) {
+        this->m_scoped = 0;
+        s_wolUiDepthScope--;
+    }
+}
+
+// The depth range of the viewport becomes 0 - 0, so whatever the orthographic z of the interface is, it is written as 0.0.
+void WOLUIDEPTH::ZBegin() {
+    if (!this->m_scoped || this->m_zChanged) {
+        return;
+    }
+
+    float minX;
+    float maxX;
+    float minY;
+    float maxY;
+    float minZ;
+    float maxZ;
+    GxXformViewport(minX, maxX, minY, maxY, minZ, maxZ);
+
+    if (minZ != 0.0f || maxZ != 0.0f) {
+        this->m_minZ = minZ;
+        this->m_maxZ = maxZ;
+        this->m_zChanged = 1;
+        GxXformSetViewport(minX, maxX, minY, maxY, 0.0f, 0.0f);
+    }
+}
+
+// Puts the previous depth range back, keeping the x/y of the viewport as they are now.
+void WOLUIDEPTH::ZEnd() {
+    if (!this->m_zChanged) {
+        return;
+    }
+
+    float minX;
+    float maxX;
+    float minY;
+    float maxY;
+    float minZ;
+    float maxZ;
+    GxXformViewport(minX, maxX, minY, maxY, minZ, maxZ);
+    GxXformSetViewport(minX, maxX, minY, maxY, this->m_minZ, this->m_maxZ);
+    this->m_zChanged = 0;
+}
+
+// Render states of an interface draw: depth test off (D3D9 ZFUNC ALWAYS, ZENABLE stays on) with depth write on, and
+// the alpha test of the Alpha and Add blends raised so that the transparent texels of glyphs and icons write nothing.
+// Call it after the blend mode and GxUpdateAlphaRef; it does nothing outside WOLUIDEPTH::Enter / Leave.
+void GxWolUiDepthStates() {
+    if (!s_wolUiDepthScope) {
+        return;
+    }
+
+    GxRsSet(GxRs_DepthTest, 0);
+    GxRsSet(GxRs_DepthWrite, 1);
+
+    int32_t blendMode = g_theGxDevicePtr->m_appRenderStates[GxRs_BlendingMode].m_value.m_data.i[0];
+    int32_t alphaRef = g_theGxDevicePtr->m_appRenderStates[GxRs_AlphaRef].m_value.m_data.i[0];
+
+    if ((blendMode == GxBlend_Alpha || blendMode == GxBlend_Add) && alphaRef > 0 && alphaRef < WOL_UI_DEPTH_ALPHA_REF) {
+        GxRsSet(GxRs_AlphaRef, WOL_UI_DEPTH_ALPHA_REF);
+    }
+}
+
