diff --git a/Engine/Source/VolFog/VolFogDump.cpp b/Engine/Source/VolFog/VolFogDump.cpp
new file mode 100644
index 0000000..a012480
--- /dev/null
+++ b/Engine/Source/VolFog/VolFogDump.cpp
@@ -0,0 +1,119 @@
+#include <cmath>
+#include <cstdio>
+#include <ctime>
+#include <direct.h>
+#include "Engine/Source/ConsoleBase/IConsole.h"
+#include "Engine/Source/VolFog/VolFog.h"
+#include "Engine/Source/VolFog/VolFogInputs.h"
+#include "Engine/Source/VolFog/VolFogModel.h"
+
+// Not in the original client (World of Legends): native volumetric fog (wolVolFog), brief B5.
+// Licensed under GPL-3.0-only (the layer fields are the ones of coa-vfog's FogLayer; see Shaders/VolFog/NOTICE-modificaciones.txt).
+//
+// wolVolFogDump: prints to the game console and appends to Logs\volfog.log (with a time stamp) the inputs the fog reads from the
+// client for the frame and the layers the model derives from them. It only prints; it is a console command, not a CVar. The
+// command runs on the event thread between frames, when the Gx matrices are not the world camera's, so it only asks for a dump
+// (RequestDump) and VolFog::Render() performs it inside the next world frame (RunPendingDump).
+
+namespace {
+    bool s_dumpPending;
+
+    void Emit(std::FILE* file, const char* line) {
+        ConsoleWrite(line, DEFAULT_COLOR);
+
+        if (file) {
+            std::fputs(line, file);
+            std::fputc('\n', file);
+        }
+    }
+
+    float Length3(const float* v) {
+        return std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+    }
+
+    void DumpNow() {
+        char line[512];
+        std::time_t now = std::time(nullptr);
+        std::tm local = {};
+        localtime_s(&local, &now);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", &local);
+
+        _mkdir("Logs");
+        std::FILE* file = std::fopen("Logs\\volfog.log", "a");
+
+        const VolFog::SettingValues& settings = VolFog::Settings();
+        std::snprintf(line, sizeof(line), "[%s] wolVolFogDump  wolVolFog=%d density=%.2f godRays=%.2f localLights=%d intzDepth=%d debug=%d", stamp, settings.quality, settings.density, settings.godRays, settings.localLights ? 1 : 0, VolFog::DepthTexture() ? 1 : 0, VolFog::s_debugMode);
+        Emit(file, line);
+
+        VolFog::FrameInputs in;
+
+        if (!VolFog::CollectInputs(in)) {
+            Emit(file, "  inputs: not available (no world frame, no camera, or a value is not finite)");
+
+            if (file) {
+                std::fclose(file);
+            }
+
+            return;
+        }
+
+        float fogColor[3];
+        float sunColor[3];
+        float directColor[3];
+        float ambientColor[3];
+        VolFog::UnpackColor(in.fogColor, fogColor);
+        VolFog::UnpackColor(in.sunColor, sunColor);
+        VolFog::UnpackColor(in.directColor, directColor);
+        VolFog::UnpackColor(in.ambientColor, ambientColor);
+
+        float hours = in.dayFraction * 24.0f;
+        int hour = static_cast<int>(hours);
+        int minute = static_cast<int>((hours - static_cast<float>(hour)) * 60.0f);
+
+        std::snprintf(line, sizeof(line), "  in: dayFraction=%.4f (game time %02d:%02d) mapId=%d lightIsMoon=%d inLiquid=%d (type %u, depth %.2f) glow=%.3f (ffxGlow %d)", in.dayFraction, hour, minute, in.mapId, in.lightIsMoon ? 1 : 0, in.inLiquid ? 1 : 0, in.liquidTypeId, in.viewerLiquidDepth, in.clientGlowAmount, in.glowEffectActive ? 1 : 0);
+        Emit(file, line);
+        std::snprintf(line, sizeof(line), "  in: toLight=(%.4f, %.4f, %.4f) |toLight|=%.4f  toRaySource=(%.4f, %.4f, %.4f) sunElevation=%.4f", in.toLight[0], in.toLight[1], in.toLight[2], Length3(in.toLight), in.toRaySource[0], in.toRaySource[1], in.toRaySource[2], in.sunElevation);
+        Emit(file, line);
+        std::snprintf(line, sizeof(line), "  in: fogColor=(%.3f, %.3f, %.3f) sunColor=(%.3f, %.3f, %.3f) directColor=(%.3f, %.3f, %.3f) ambientColor=(%.3f, %.3f, %.3f)", fogColor[0], fogColor[1], fogColor[2], sunColor[0], sunColor[1], sunColor[2], directColor[0], directColor[1], directColor[2], ambientColor[0], ambientColor[1], ambientColor[2]);
+        Emit(file, line);
+        std::snprintf(line, sizeof(line), "  in: fogStart=%.2f fogEnd=%.2f zoneFogDistance=%.2f farClip=%.2f", in.fogStart, in.fogEnd, in.zoneFogDistance, in.farClip);
+        Emit(file, line);
+        std::snprintf(line, sizeof(line), "  in: cameraInterior=%d interiorBlend=%.3f fullyInterior=%d  camPos=(%.2f, %.2f, %.2f) camTarget=(%.2f, %.2f, %.2f)", in.localLights.cameraInterior ? 1 : 0, in.localLights.interiorBlend, in.fullyInterior ? 1 : 0, in.camPos[0], in.camPos[1], in.camPos[2], in.camTarget[0], in.camTarget[1], in.camTarget[2]);
+        Emit(file, line);
+        std::snprintf(line, sizeof(line), "  in: viewport=%u,%u %ux%u z %.2f..%.2f  projection far plane=%.2f", in.viewport.x, in.viewport.y, in.viewport.width, in.viewport.height, in.viewport.minZ, in.viewport.maxZ, in.glProjection[14] / (1.0f - in.glProjection[10]));
+        Emit(file, line);
+
+        VolFog::ModelTuning tuning = VolFog::CurrentTuning();
+        VolFog::FogParams fog = VolFog::BuildFogParams(in, tuning);
+
+        std::snprintf(line, sizeof(line), "  fog: active=%d linear=%d lightVisibility=%.4f lightAboveHorizon=%.4f referenceZ=%.2f farLimit=%.2f maxDistance=%.1f horizonStart=%.1f farClip=%.1f", fog.active ? 1 : 0, fog.linear ? 1 : 0, fog.lightVisibility, fog.lightAboveHorizon, fog.referenceZ, fog.farLimit, fog.maxDistance, fog.horizonStart, fog.farClip);
+        Emit(file, line);
+
+        static const char* const s_layerNames[VolFog::kFogLayers] = { "haze", "low fog", "unused", "distance" };
+
+        for (int i = 0; i < VolFog::kFogLayers; ++i) {
+            const VolFog::FogLayer& l = fog.layers[i];
+            std::snprintf(line, sizeof(line), "  layer %d (%s): start=%.2f density=%.7f g=%.2f isotropic=%.2f emissive=(%.3f, %.3f, %.3f) diffuse=(%.3f, %.3f, %.3f) upper=%.2f/%.5f lower=%.2f/%.5f strength=%.1f exponent=%.1f skyFalloff=%.1f endDistance=%.2f", i, s_layerNames[i], l.start, l.density, l.g, l.isotropic, l.emissive[0], l.emissive[1], l.emissive[2], l.diffuse[0], l.diffuse[1], l.diffuse[2], l.upperHeight, l.upperFalloff, l.lowerHeight, l.lowerFalloff, l.strength, l.exponent, l.skyFalloff, l.endDistance);
+            Emit(file, line);
+        }
+
+        if (file) {
+            std::fclose(file);
+        }
+    }
+}
+
+void VolFog::RequestDump() {
+    if (!s_dumpPending) {
+        s_dumpPending = true;
+        ConsoleWrite("wolVolFogDump: the dump is written in the next world frame (Logs\\volfog.log).", DEFAULT_COLOR);
+    }
+}
+
+void VolFog::RunPendingDump() {
+    if (s_dumpPending) {
+        s_dumpPending = false;
+        DumpNow();
+    }
+}
diff --git a/Engine/Source/VolFog/VolFogInputs.cpp b/Engine/Source/VolFog/VolFogInputs.cpp
new file mode 100644
index 0000000..35dec68
--- /dev/null
+++ b/Engine/Source/VolFog/VolFogInputs.cpp
@@ -0,0 +1,55 @@
+#include "Engine/Source/VolFog/VolFogInputs.h"
+
+#include <cmath>
+#include <cstring>
+
+// Not in the original client (World of Legends): native volumetric fog (wolVolFog), brief B5.
+// Licensed under GPL-3.0-only (see VolFogInputs.h and Shaders/VolFog/NOTICE-modificaciones.txt).
+
+VolFog::InputsProvider VolFog::s_inputsProvider;
+
+namespace {
+    bool Finite(const float* values, int count) {
+        for (int i = 0; i < count; ++i) {
+            if (!std::isfinite(values[i])) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+}
+
+// Same conversion as UnpackColor in coa-vfog's fog_model.cpp.
+void VolFog::UnpackColor(uint32_t argb, float* rgb) {
+    rgb[0] = static_cast<float>((argb >> 16) & 0xFF) / 255.0f;
+    rgb[1] = static_cast<float>((argb >> 8) & 0xFF) / 255.0f;
+    rgb[2] = static_cast<float>(argb & 0xFF) / 255.0f;
+}
+
+bool VolFog::CollectInputs(FrameInputs& out) {
+    std::memset(&out, 0, sizeof(out));
+    out.viewport.maxZ = 1.0f;
+
+    if (!VolFog::s_inputsProvider || !VolFog::s_inputsProvider(out)) {
+        std::memset(&out, 0, sizeof(out));
+        out.viewport.maxZ = 1.0f;
+
+        return false;
+    }
+
+    bool finite = Finite(out.cameraRelativeView, 16) && Finite(out.glProjection, 16) && Finite(out.camPos, 3)
+        && Finite(out.camTarget, 3) && Finite(out.toLight, 3) && Finite(out.toRaySource, 3)
+        && std::isfinite(out.dayFraction) && std::isfinite(out.fogStart) && std::isfinite(out.fogEnd)
+        && std::isfinite(out.zoneFogDistance) && std::isfinite(out.farClip) && std::isfinite(out.clientGlowAmount)
+        && std::isfinite(out.localLights.interiorBlend);
+
+    if (!finite) {
+        std::memset(&out, 0, sizeof(out));
+        out.viewport.maxZ = 1.0f;
+
+        return false;
+    }
+
+    return true;
+}
diff --git a/Engine/Source/VolFog/VolFogInputs.h b/Engine/Source/VolFog/VolFogInputs.h
new file mode 100644
index 0000000..ac44b91
--- /dev/null
+++ b/Engine/Source/VolFog/VolFogInputs.h
@@ -0,0 +1,78 @@
+#ifndef ENGINE_SOURCE_VOLFOG_VOLFOGINPUTS_H
+#define ENGINE_SOURCE_VOLFOG_VOLFOGINPUTS_H
+
+#include <cstdint>
+
+// Not in the original client (World of Legends): native volumetric fog (wolVolFog), brief B5.
+// Licensed under GPL-3.0-only. FrameInputs is derived from `struct FrameInputs` of src/engine.h in coa-vfog 205ade5 (copyright of
+// the authors of CoAVolFog, jealous-sound and the contributors of the Raz0r1337 fork; see Shaders/VolFog/NOTICE-modificaciones.txt).
+// Modified 2026-10-20 (brief B5): in the namespace VolFog; D3DVIEWPORT9 replaced by VolFog::Viewport; the Classic-only members
+// (lightParams, point light table) are gone; toRaySource added; the values are read straight from the client instead of from fixed
+// addresses (WoW/Source/WorldClient/VolFogWorld.cpp).
+
+namespace VolFog {
+    // The world viewport that CGWorldFrame::OnWorldRender left set, in pixels from the top-left corner of the back buffer (same
+    // meaning as D3DVIEWPORT9), plus its depth range (z 0..0.94 for the world).
+    struct Viewport {
+        uint32_t x = 0;
+        uint32_t y = 0;
+        uint32_t width = 0;
+        uint32_t height = 0;
+        float minZ = 0.0f;
+        float maxZ = 1.0f;
+    };
+
+    // Brief B5: only the two interior values are filled; the point light table (up to 8 lights) is brief B8.
+    struct LocalLightInputs {
+        bool cameraInterior = false;    // the viewer is inside a WMO group that is not an exterior group (flags & 0x48 == 0)
+        float interiorBlend = 0.0f;     // 0..1: DNInfo.m_interiorFogBlend (distance to the nearest exterior portal * 0.04); 1 when no portal sees outside
+        uint32_t pointLightCount = 0;   // B8
+    };
+
+    // Everything the fog model and the passes need from the client for one frame (design 1.3). The member names are the ones of
+    // coa-vfog's FrameInputs, so that the packing of the constants (renderer.cpp) can be followed one to one.
+    struct FrameInputs {
+        float cameraRelativeView[16];   // GxXformView: eye at the origin, row-major, the same layout as the D3D matrix
+        float glProjection[16];         // GxXformProjection (GxuXformCreateProjection_Exact): ndc z = c2 + d2 / z, so far plane = [14] / (1 - [10])
+        float camPos[3];                // active camera position (world space)
+        float camTarget[3];             // the camera target (DNInfo.m_lightRefPos: the followed unit, or the camera itself)
+        Viewport viewport;
+        float dayFraction;              // DNInfo.m_dayProgression 0..1 (0.5 = noon)
+        float toLight[3];               // unit vector to the light that scatters: -DNInfo.m_light1.m_dir
+        bool lightIsMoon;               // the sun is below the horizon
+        uint32_t fogColor;              // A8R8G8B8, DNInfo.m_fogInterior.m_color (= m_fog.m_color outside; blended inside a WMO)
+        uint32_t sunColor;              // DNInfo.m_bands.m_sunCloudColors[0]
+        uint32_t directColor;           // DNInfo.m_bands.m_diffuse (SetLightColors: m_light1.m_diffuse)
+        uint32_t ambientColor;          // DNInfo.m_bands.m_ambient (SetLightColors: m_light1.m_ambient)
+        float fogStart;                 // DNInfo.m_fogInterior.m_start after UpdateFog
+        float fogEnd;                   // DNInfo.m_fogInterior.m_end after UpdateFog
+        float zoneFogDistance;          // DNInfo.m_bands.m_fogEnd (Light.dbc, before the far clip and the wolFarclipFactor)
+        float farClip;                  // DNInfo.m_farClip = camera far plane
+        float clientGlowAmount;         // DNInfo.m_bands.m_glow, only while ffxGlow is the active screen effect (0 otherwise, 0 in liquid)
+        bool inLiquid;                  // World::SceneCamLiquidStatus != 0
+        int32_t mapId;                  // World::QueryMapId
+        LocalLightInputs localLights;
+        // Added in brief B5 (not in coa-vfog's struct): the beams (brief B9) come from the visual position of the body, which does not
+        // coincide with the light direction.
+        float toRaySource[3];           // unit vector to the visual position of the sun, or of the moon when lightIsMoon
+        float sunElevation;             // z of the unit vector to the visual sun position (negative = below the horizon); lightIsMoon = it is < 0
+        float viewerLiquidDepth;        // World::SceneCamLiquidStatus(&depth): for the dump
+        uint32_t liquidTypeId;          // the same call, return value
+        bool fullyInterior;             // the viewer is in a WMO and no portal sees the outside (CPortalView::m_maxViewDepth < 0)
+        bool glowEffectActive;          // ffxGlow is the active screen effect
+    };
+
+    // The client side (WoW/Source/WorldClient/VolFogWorld.cpp) installs this when the CVars are registered: Engine/ does not depend
+    // on WoW/, so it only sees a function pointer. It returns false when it cannot fill the structure (no world frame, no camera).
+    typedef bool (*InputsProvider)(FrameInputs& out);
+    extern InputsProvider s_inputsProvider;
+
+    // Fills `out` from the client for the frame being drawn (call it from inside the world render: the matrices are the world camera's).
+    // Returns false, with `out` zeroed, when there is no provider, the provider fails or a value is not finite.
+    bool CollectInputs(FrameInputs& out);
+
+    // Small float helpers shared with the model: ARGB to 0..1 RGB.
+    void UnpackColor(uint32_t argb, float* rgb);
+}
+
+#endif
diff --git a/Engine/Source/VolFog/VolFogModel.cpp b/Engine/Source/VolFog/VolFogModel.cpp
new file mode 100644
index 0000000..a145be4
--- /dev/null
+++ b/Engine/Source/VolFog/VolFogModel.cpp
@@ -0,0 +1,265 @@
+#include "Engine/Source/VolFog/VolFogModel.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include "Engine/Source/VolFog/VolFog.h"
+
+// Not in the original client (World of Legends): native volumetric fog (wolVolFog), brief B5.
+// Licensed under GPL-3.0-only. Derived from src/fog_model.cpp of coa-vfog 205ade5 (copyright of the authors of CoAVolFog,
+// jealous-sound and the contributors of the Raz0r1337 fork; see Shaders/VolFog/NOTICE-modificaciones.txt).
+// Modified 2026-10-20 (brief B5): in the namespace VolFog; only the derived mode is kept (DerivedLayers, DistanceLayer,
+// ApplyInteriorFog and the matrix helpers; the authored/Classic layers, noise and direct-light matching are gone); Config is
+// replaced by ModelTuning; FogParams gains `active` (false in liquid).
+
+namespace {
+    constexpr float kHazeDensity = 0.00035f;
+    constexpr float kHazeG = 0.75f;
+    constexpr float kHazeIsotropic = 0.3f;
+    constexpr float kHazeFalloff = 1.0f / 220.0f;
+    constexpr float kHazeSun = 1.3f;
+    constexpr float kHazeAmbient = 0.8f;
+
+    constexpr float kGroundStart = 12.0f;
+    constexpr float kGroundOpticalDepth = 1.1f;
+    constexpr float kGroundG = 0.4f;
+    constexpr float kGroundIsotropic = 0.5f;
+    constexpr float kGroundFalloff = 1.0f / 18.0f;
+    constexpr float kGroundSun = 0.8f;
+    constexpr float kGroundAmbient = 0.75f;
+
+    constexpr float kFarOpticalDepth = 3.0f;
+    constexpr float kFarRamp = 60.0f;
+    constexpr float kFarStartFraction = 0.25f;
+    constexpr float kFarG = 0.2f;
+    constexpr float kFarIsotropic = 0.7f;
+    constexpr float kFarSun = 0.45f;
+    constexpr float kFarAmbient = 0.6f;
+    constexpr float kFarSkyFalloff = 10.0f;
+    constexpr float kFarExponent = 2.0f;
+
+    constexpr float kDerivedLayerLimit = 1500.0f;
+
+    constexpr float kLightSettingHalfWidth = 0.02f;
+    constexpr float kReferenceFarTarget = 200.0f;
+    constexpr float kNoLimit = 1.0e9f;
+
+    float SmoothStep(float e0, float e1, float x) {
+        float t = std::clamp((x - e0) / (e1 - e0), 0.0f, 1.0f);
+
+        return t * t * (3.0f - 2.0f * t);
+    }
+
+    void Scale(const float* rgb, float s, float* out) {
+        out[0] = rgb[0] * s;
+        out[1] = rgb[1] * s;
+        out[2] = rgb[2] * s;
+    }
+
+    void Encode(float* rgb, bool linear) {
+        if (linear) {
+            for (int i = 0; i < 3; ++i) {
+                rgb[i] = std::pow(std::max(rgb[i], 0.0f), 2.2f);
+            }
+        }
+    }
+
+    float ReferenceZ(const VolFog::FrameInputs& in) {
+        float dx = in.camTarget[0] - in.camPos[0];
+        float dy = in.camTarget[1] - in.camPos[1];
+        float dz = in.camTarget[2] - in.camPos[2];
+
+        if (dx * dx + dy * dy + dz * dz > kReferenceFarTarget * kReferenceFarTarget) {
+            return in.camPos[2] - 2.0f;
+        }
+
+        return std::min(in.camPos[2], in.camTarget[2]) - 1.0f;
+    }
+
+    void Unshadowed(VolFog::FogLayer& l) {
+        std::memcpy(l.shadowEmissive, l.emissive, sizeof(l.emissive));
+        l.shadowDensity = 1.0f;
+        l.shadowed = 0.0f;
+    }
+
+    void Unbounded(VolFog::FogLayer& l) {
+        l.skyFalloff = 0.0f;
+        l.endDistance = kNoLimit;
+        l.densityVariation = 1.0f;
+    }
+
+    void DerivedLayers(const VolFog::ModelTuning& cfg, const VolFog::FogParams& p, float sunScatter, float fogDistance, const float* fogColor, VolFog::FogLayer* out) {
+        float foggyZone = std::clamp(700.0f / fogDistance, 0.6f, 2.5f);
+
+        VolFog::FogLayer& haze = out[0];
+        haze = VolFog::FogLayer{};
+        haze.start = 0.0f;
+        haze.density = kHazeDensity * cfg.haze * cfg.density * foggyZone;
+        haze.g = kHazeG;
+        haze.isotropic = kHazeIsotropic;
+        Scale(fogColor, kHazeAmbient * cfg.ambient, haze.emissive);
+        Scale(p.lightColor, kHazeSun * sunScatter, haze.diffuse);
+        haze.exponent = 1.0f;
+        haze.upperHeight = p.referenceZ;
+        haze.upperFalloff = kHazeFalloff;
+        Unshadowed(haze);
+        Unbounded(haze);
+        haze.endDistance = kDerivedLayerLimit;
+
+        VolFog::FogLayer& ground = out[1];
+        ground = VolFog::FogLayer{};
+        ground.start = kGroundStart;
+        ground.density = kGroundOpticalDepth * cfg.groundFog * cfg.density / std::max(fogDistance, 250.0f);
+        ground.g = kGroundG;
+        ground.isotropic = kGroundIsotropic;
+        Scale(fogColor, kGroundAmbient * cfg.ambient, ground.emissive);
+        Scale(p.lightColor, kGroundSun * sunScatter, ground.diffuse);
+        ground.exponent = 1.0f;
+        ground.upperHeight = p.referenceZ;
+        ground.upperFalloff = kGroundFalloff;
+        Unshadowed(ground);
+        Unbounded(ground);
+        ground.endDistance = kDerivedLayerLimit;
+
+        out[2] = VolFog::FogLayer{};
+        Unbounded(out[2]);
+    }
+
+    float DistanceFogOpticalDepthPerDensity(float farStart, float farLimit, float range) {
+        const float spanFraction = (farLimit - farStart) / range;
+
+        return range * (spanFraction + kFarRamp * spanFraction * spanFraction * spanFraction / 3.0f);
+    }
+
+    void DistanceLayer(const VolFog::FrameInputs& in, const VolFog::ModelTuning& cfg, const VolFog::FogParams& p, float sunScatter, const float* fogColor, VolFog::FogLayer& out) {
+        out = VolFog::FogLayer{};
+        float farStart = std::min(std::max(in.fogStart, 0.0f), p.farLimit * kFarStartFraction);
+        float opticalDepthPerDensity = DistanceFogOpticalDepthPerDensity(farStart, p.farLimit, p.maxDistance);
+        out.start = farStart;
+        out.density = cfg.stockFog && opticalDepthPerDensity > 0.0f ? kFarOpticalDepth * cfg.farFog * cfg.density / opticalDepthPerDensity : 0.0f;
+        out.g = kFarG;
+        out.isotropic = kFarIsotropic;
+        out.strength = kFarRamp;
+        out.exponent = kFarExponent;
+        out.skyFalloff = kFarSkyFalloff;
+        out.endDistance = p.farLimit;
+        Scale(fogColor, kFarAmbient * cfg.ambient, out.emissive);
+        Scale(p.lightColor, kFarSun * sunScatter, out.diffuse);
+        Unshadowed(out);
+    }
+
+    float InteriorWeight(const VolFog::FrameInputs& in, const VolFog::ModelTuning& cfg) {
+        return cfg.interiorAware && in.localLights.cameraInterior && std::isfinite(in.localLights.interiorBlend) ? std::clamp(in.localLights.interiorBlend, 0.0f, 1.0f) : 0.0f;
+    }
+
+    void ApplyInteriorFog(float weight, const VolFog::ModelTuning& cfg, VolFog::FogParams& fog) {
+        const float retainedDensity = std::isfinite(cfg.interiorDensity) ? std::clamp(cfg.interiorDensity, 0.0f, 1.0f) : 0.15f;
+        const float densityScale = 1.0f + (retainedDensity - 1.0f) * weight;
+
+        for (int i = 0; i < VolFog::kSceneLayers; ++i) {
+            fog.layers[i].density *= densityScale;
+        }
+
+        const float retainedFarFog = std::isfinite(cfg.interiorFarFog) ? std::clamp(cfg.interiorFarFog, 0.0f, 1.0f) : 1.0f;
+        fog.layers[VolFog::kDistanceFogLayer].density *= 1.0f + (retainedFarFog - 1.0f) * weight;
+
+        for (VolFog::FogLayer& layer : fog.layers) {
+            Scale(layer.diffuse, 1.0f - weight, layer.diffuse);
+        }
+
+        fog.lightVisibility *= 1.0f - weight;
+    }
+}
+
+VolFog::ModelTuning VolFog::CurrentTuning() {
+    ModelTuning tuning;
+    tuning.density = VolFog::Settings().density;
+
+    return tuning;
+}
+
+VolFog::FogParams VolFog::BuildFogParams(const FrameInputs& in, const ModelTuning& cfg) {
+    FogParams p = {};
+    p.linear = cfg.linear;
+    p.active = !in.inLiquid;
+    const float interiorWeight = InteriorWeight(in, cfg);
+    float fogColor[3];
+    VolFog::UnpackColor(in.fogColor, fogColor);
+    VolFog::UnpackColor(in.directColor, p.lightColor);
+    VolFog::UnpackColor(in.lightIsMoon ? in.directColor : in.sunColor, p.rayColor);
+    Encode(fogColor, p.linear);
+    Encode(p.lightColor, p.linear);
+
+    float elevation = SmoothStep(-0.03f, 0.10f, in.toLight[2]);
+    p.lightVisibility = elevation * (in.lightIsMoon ? kMoonLightScale : 1.0f);
+    p.lightAboveHorizon = SmoothStep(-kLightSettingHalfWidth, kLightSettingHalfWidth, in.toLight[2]);
+    p.farClip = in.farClip;
+    p.maxDistance = std::max(cfg.maxDistance, in.farClip);
+    p.horizonStart = in.farClip * 0.85f;
+    p.referenceZ = ReferenceZ(in);
+    p.farLimit = std::clamp(in.fogEnd, 100.0f, in.farClip);
+
+    float fogDistance = in.zoneFogDistance > 50.0f && in.zoneFogDistance < 20000.0f ? in.zoneFogDistance : in.fogEnd;
+    fogDistance = std::clamp(fogDistance, 50.0f, 5000.0f);
+    float elevationFadedScatter = p.lightVisibility * cfg.sunScatter;
+
+    FogLayer& distanceFog = p.layers[kDistanceFogLayer];
+    DerivedLayers(cfg, p, elevationFadedScatter, fogDistance, fogColor, p.layers);
+    DistanceLayer(in, cfg, p, elevationFadedScatter, fogColor, distanceFog);
+    ApplyInteriorFog(interiorWeight, cfg, p);
+
+    return p;
+}
+
+void VolFog::Mul4x4(const float* a, const float* b, float* out) {
+    float r[16];
+
+    for (int i = 0; i < 4; ++i) {
+        for (int j = 0; j < 4; ++j) {
+            r[i * 4 + j] = a[i * 4 + 0] * b[0 * 4 + j] + a[i * 4 + 1] * b[1 * 4 + j] + a[i * 4 + 2] * b[2 * 4 + j] + a[i * 4 + 3] * b[3 * 4 + j];
+        }
+    }
+
+    std::memcpy(out, r, sizeof(r));
+}
+
+bool VolFog::Invert4x4(const float* m, float* out) {
+    double inv[16];
+    inv[0] = m[5] * m[10] * m[15] - m[5] * m[11] * m[14] - m[9] * m[6] * m[15] + m[9] * m[7] * m[14] + m[13] * m[6] * m[11] - m[13] * m[7] * m[10];
+    inv[4] = -m[4] * m[10] * m[15] + m[4] * m[11] * m[14] + m[8] * m[6] * m[15] - m[8] * m[7] * m[14] - m[12] * m[6] * m[11] + m[12] * m[7] * m[10];
+    inv[8] = m[4] * m[9] * m[15] - m[4] * m[11] * m[13] - m[8] * m[5] * m[15] + m[8] * m[7] * m[13] + m[12] * m[5] * m[11] - m[12] * m[7] * m[9];
+    inv[12] = -m[4] * m[9] * m[14] + m[4] * m[10] * m[13] + m[8] * m[5] * m[14] - m[8] * m[6] * m[13] - m[12] * m[5] * m[10] + m[12] * m[6] * m[9];
+    inv[1] = -m[1] * m[10] * m[15] + m[1] * m[11] * m[14] + m[9] * m[2] * m[15] - m[9] * m[3] * m[14] - m[13] * m[2] * m[11] + m[13] * m[3] * m[10];
+    inv[5] = m[0] * m[10] * m[15] - m[0] * m[11] * m[14] - m[8] * m[2] * m[15] + m[8] * m[3] * m[14] + m[12] * m[2] * m[11] - m[12] * m[3] * m[10];
+    inv[9] = -m[0] * m[9] * m[15] + m[0] * m[11] * m[13] + m[8] * m[1] * m[15] - m[8] * m[3] * m[13] - m[12] * m[1] * m[11] + m[12] * m[3] * m[9];
+    inv[13] = m[0] * m[9] * m[14] - m[0] * m[10] * m[13] - m[8] * m[1] * m[14] + m[8] * m[2] * m[13] + m[12] * m[1] * m[10] - m[12] * m[2] * m[9];
+    inv[2] = m[1] * m[6] * m[15] - m[1] * m[7] * m[14] - m[5] * m[2] * m[15] + m[5] * m[3] * m[14] + m[13] * m[2] * m[7] - m[13] * m[3] * m[6];
+    inv[6] = -m[0] * m[6] * m[15] + m[0] * m[7] * m[14] + m[4] * m[2] * m[15] - m[4] * m[3] * m[14] - m[12] * m[2] * m[7] + m[12] * m[3] * m[6];
+    inv[10] = m[0] * m[5] * m[15] - m[0] * m[7] * m[13] - m[4] * m[1] * m[15] + m[4] * m[3] * m[13] + m[12] * m[1] * m[7] - m[12] * m[3] * m[5];
+    inv[14] = -m[0] * m[5] * m[14] + m[0] * m[6] * m[13] + m[4] * m[1] * m[14] - m[4] * m[2] * m[13] - m[12] * m[1] * m[6] + m[12] * m[2] * m[5];
+    inv[3] = -m[1] * m[6] * m[11] + m[1] * m[7] * m[10] + m[5] * m[2] * m[11] - m[5] * m[3] * m[10] - m[9] * m[2] * m[7] + m[9] * m[3] * m[6];
+    inv[7] = m[0] * m[6] * m[11] - m[0] * m[7] * m[10] - m[4] * m[2] * m[11] + m[4] * m[3] * m[10] + m[8] * m[2] * m[7] - m[8] * m[3] * m[6];
+    inv[11] = -m[0] * m[5] * m[11] + m[0] * m[7] * m[9] + m[4] * m[1] * m[11] - m[4] * m[3] * m[9] - m[8] * m[1] * m[7] + m[8] * m[3] * m[5];
+    inv[15] = m[0] * m[5] * m[10] - m[0] * m[6] * m[9] - m[4] * m[1] * m[10] + m[4] * m[2] * m[9] + m[8] * m[1] * m[6] - m[8] * m[2] * m[5];
+    double det = m[0] * inv[0] + m[1] * inv[4] + m[2] * inv[8] + m[3] * inv[12];
+
+    if (std::fabs(det) < 1e-12) {
+        return false;
+    }
+
+    for (int i = 0; i < 16; ++i) {
+        out[i] = static_cast<float>(inv[i] / det);
+    }
+
+    return true;
+}
+
+void VolFog::TransformDirection(const float* v, const float* m, float* out) {
+    float r[3];
+
+    for (int j = 0; j < 3; ++j) {
+        r[j] = v[0] * m[0 * 4 + j] + v[1] * m[1 * 4 + j] + v[2] * m[2 * 4 + j];
+    }
+
+    std::memcpy(out, r, sizeof(r));
+}
