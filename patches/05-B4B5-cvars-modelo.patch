+// Not in the original client (brief B4). Whole-string number test for the wolVolFog* float CVars: a value such as "2x" or "" is
+// rejected instead of being read as 0 (SStrToFloat).
+static bool WolVolFogParseFloat(const char* value, float& result) {
+    if (!value || !*value) {
+        return false;
+    }
+
+    char* end = nullptr;
+    double parsed = strtod(value, &end);
+
+    if (end == value || *end != '\0' || parsed != parsed) {
+        return false;
+    }
+
+    result = static_cast<float>(parsed);
+
+    return true;
+}
+
+// Not in the original client (brief B4). wolVolFogDensity 0.0-4.0 (default 1.0): multiplies the haze, the low fog and the distance
+// fog of the model (VolFogModel.cpp). Read every frame, so it applies at once.
+bool CWorldParam::WolVolFogDensityCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    float density = 0.0f;
+
+    if (!WolVolFogParseFloat(value, density) || density < 0.0f || density > 4.0f) {
+        ConsoleWrite("wolVolFogDensity must be in range 0.0 to 4.0.", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    VolFog::SetDensity(density);
+
+    // No message while the CVar is first registered (no previous value).
+    if (oldValue && *oldValue) {
+        char buffer[64];
+        SStrPrintf(buffer, sizeof(buffer), "wolVolFogDensity: %.2f", static_cast<double>(density));
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+    }
+
+    return true;
+}
+
+// Not in the original client (brief B4). wolVolFogGodRays 0.0-1.0 (default 0.0): strength of the radial light shafts (0 = off).
+bool CWorldParam::WolVolFogGodRaysCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    float strength = 0.0f;
+
+    if (!WolVolFogParseFloat(value, strength) || strength < 0.0f || strength > 1.0f) {
+        ConsoleWrite("wolVolFogGodRays must be in range 0.0 to 1.0.", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    VolFog::SetGodRays(strength);
+
+    if (oldValue && *oldValue) {
+        char buffer[64];
+        SStrPrintf(buffer, sizeof(buffer), "wolVolFogGodRays: %.2f", static_cast<double>(strength));
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+    }
+
+    return true;
+}
+
+// Not in the original client (brief B4). wolVolFogLocalLights 0 or 1 (default 1): point lights scattered in the fog.
+bool CWorldParam::WolVolFogLocalLightsCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    if (!value || (value[0] != '0' && value[0] != '1') || value[1] != '\0') {
+        ConsoleWrite("wolVolFogLocalLights must be 0 (off) or 1 (on).", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    VolFog::SetLocalLights(value[0] == '1');
+
+    if (oldValue && *oldValue) {
+        char buffer[64];
+        SStrPrintf(buffer, sizeof(buffer), "wolVolFogLocalLights: %s", value[0] == '1' ? "on" : "off");
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+    }
+
+    return true;
+}
