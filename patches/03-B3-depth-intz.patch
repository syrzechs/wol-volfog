+        CGxDevice::Log("%s", s_pending);
+    } else if (changed && mode > 0 && !VolFog::s_caps.intz) {
+        static const char* const s_noIntz = "wolVolFog: this video card does not report INTZ, the fog stays off.";
+        ConsoleWrite(s_noIntz, DEFAULT_COLOR);
+        CGxDevice::Log("%s", s_noIntz);
+    }
+
+    return true;
+}
