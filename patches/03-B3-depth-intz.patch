             float c0[4] = { this->m_viewportPx[0], this->m_viewportPx[1], this->m_viewportPx[2], this->m_viewportPx[3] };
-            float c1[4] = { 1.0f, 0.0f, 1.0f / this->m_targetPx[0], 1.0f / this->m_targetPx[1] };
-            // Depth to view z: filled in by the brief that reads the depth (B3); max distance and deepest world depth as in the design.
