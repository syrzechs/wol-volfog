+bool CWorldParam::WolVolFogCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    int32_t mode = -1;
+
+    if (value && value[0] >= '0' && value[0] <= '3' && value[1] == '\0') {
+        mode = value[0] - '0';
+    }
+
+    if (mode < 0) {
+        ConsoleWrite("wolVolFog must be 0 (off), 1 (low), 2 (medium) or 3 (high).", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    VolFog::s_mode = mode;
+    VolFog::s_messageHook = WolVolFogMessage;
+
+    // No caps line while the CVar is first registered (no previous value): only when somebody changes it.
