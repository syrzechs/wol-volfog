diff --git a/Engine/Source/Gx/GxFramePacer.cpp b/Engine/Source/Gx/GxFramePacer.cpp
new file mode 100644
index 0000000..0c95788
--- /dev/null
+++ b/Engine/Source/Gx/GxFramePacer.cpp
@@ -0,0 +1,77 @@
+// Not in the original client (World of Legends): precise frame cap for maxFPS / maxFPSBk, switched on with the CVar
+// wolMaxFPSPrecise (off by default). See patches-cliente/topes-2008/README-topes.md.
+//
+// The original CGxDevice::WaitForFPSCap waits a whole number of milliseconds per frame (1000 / maxFPS, rounded down), so
+// maxFPS 144 caps at ~166 fps and maxFPS 240 at 250. This version keeps a QueryPerformanceCounter cadence, sleeps on a
+// high-resolution waitable timer until about half a millisecond before the deadline and spins the rest.
+
+#include <windows.h>
+#include <cstdint>
+#include "Engine/Source/Gx/Gx.h"
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+static int32_t s_preciseFpsCap;
+static LARGE_INTEGER s_frequency;
+static int64_t s_nextFrame;
+static HANDLE s_timer;
+static bool s_timerTried;
+
+void GxSetMaxFPSPrecise(int32_t enable) {
+    s_preciseFpsCap = enable ? 1 : 0;
+    s_nextFrame = 0;
+}
+
+int32_t GxGetMaxFPSPrecise() {
+    return s_preciseFpsCap;
+}
+
+void GxWaitForFrameRatePrecise(uint32_t maxFps) {
+    if (!maxFps) {
+        return;
+    }
+
+    if (!s_frequency.QuadPart) {
+        QueryPerformanceFrequency(&s_frequency);
+    }
+
+    if (!s_timerTried) {
+        s_timerTried = true;
+        // Windows 10 1803 and later; without it the wait below falls back to Sleep(0) spinning.
+        s_timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    }
+
+    int64_t frequency = s_frequency.QuadPart;
+    int64_t period = frequency / maxFps;
+
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+
+    int64_t remaining = s_nextFrame - now.QuadPart;
+
+    // Late, first frame, or a deadline more than a second away (maxFPS changed): restart the cadence from now.
+    if (remaining <= 0 || remaining > frequency) {
+        s_nextFrame = now.QuadPart + period;
+        return;
+    }
+
+    int64_t spin = frequency / 2000;
+
+    if (remaining > spin && s_timer) {
+        LARGE_INTEGER due;
+        due.QuadPart = -((remaining - spin) * 10000000 / frequency);
+
+        if (SetWaitableTimerEx(s_timer, &due, 0, nullptr, nullptr, nullptr, 0)) {
+            WaitForSingleObject(s_timer, INFINITE);
+        }
+    }
+
+    do {
+        Sleep(0);
+        QueryPerformanceCounter(&now);
+    } while (now.QuadPart < s_nextFrame);
+
+    s_nextFrame += period;
+}
