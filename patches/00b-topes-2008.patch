diff --git a/WoW/Source/ConsoleDevice/WolDpi.cpp b/WoW/Source/ConsoleDevice/WolDpi.cpp
new file mode 100644
index 0000000..db3787a
--- /dev/null
+++ b/WoW/Source/ConsoleDevice/WolDpi.cpp
@@ -0,0 +1,28 @@
+// Not in the original client (World of Legends): CVar wolDpiAware, see patches-cliente/topes-2008/README-topes.md.
+//
+// The client has no DPI awareness in its manifest. With Windows display scaling above 100% (the default on most 4K
+// monitors is 150%) Windows shows it a scaled-down desktop (3840x2160 at 150% looks like 2560x1440), so a windowed
+// 3840x2160 falls back to 1600x1200 in ValidateFormatMonitor and a maximized window is rendered small and stretched by
+// the desktop compositor (blurry). Declaring the process system DPI aware before the first window is created makes it
+// see and render the real pixels.
+
+#include <windows.h>
+#include <cstdint>
+
+bool WolSetProcessDpiAware() {
+    typedef BOOL(WINAPI * SetProcessDpiAwarenessContextFn)(HANDLE);
+
+    HMODULE user32 = GetModuleHandleW(L"user32.dll");
+
+    if (user32) {
+        SetProcessDpiAwarenessContextFn setContext = reinterpret_cast<SetProcessDpiAwarenessContextFn>(GetProcAddress(user32, "SetProcessDpiAwarenessContext"));
+
+        if (setContext) {
+            // DPI_AWARENESS_CONTEXT_SYSTEM_AWARE (Windows 10 1703 and later).
+            return setContext(reinterpret_cast<HANDLE>(static_cast<intptr_t>(-2))) != FALSE;
+        }
+    }
+
+    // Windows Vista and later.
+    return SetProcessDPIAware() != FALSE;
+}
