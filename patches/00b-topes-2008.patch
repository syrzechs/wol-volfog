+    // m_fov of PI / 2 is a 54 degree vertical angle. Computed in double so that 54 gives exactly 1.5707964f again.
+    return static_cast<float>(static_cast<double>(s_wolFovVertical) / 0.6 * (3.14159265358979323846 / 180.0));
