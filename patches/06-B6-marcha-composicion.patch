+namespace {
+    bool s_hardFailure;
+    bool s_lastFrameOk = true;
+    bool s_inLiquid;
+    uint32_t s_deviceEpoch;
+}
+
+bool VolFog::Armed() {
+    return VolFog::s_mode > 0 && VolFog::s_caps.intz && VolFog::s_caps.ps30Slots >= 1024 && VolFog::DepthTexture() != nullptr && !s_hardFailure && s_lastFrameOk && !s_inLiquid && (VolFog::s_debugMode == 0 || VolFog::s_debugMode == 2);
