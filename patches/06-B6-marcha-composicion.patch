+    // The constants of one frame (Renderer::Draw of renderer.cpp, without the temporal filter, the local lights and the beams).
+    bool PackFrame(const VolFog::FrameInputs& in, const VolFog::FogParams& fog, uint32_t scale, uint32_t lowWidth, uint32_t lowHeight, float debugView, FogFrame& f) {
