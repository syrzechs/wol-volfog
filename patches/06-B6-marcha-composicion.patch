+        // MapWorldDepth: the world is drawn in the viewport depth range 0..0.94 (minZ..maxZ of the frame).
+        const bool usableRange = in.viewport.maxZ - in.viewport.minZ > 0.01f && in.viewport.minZ >= 0.0f && in.viewport.maxZ <= 1.0f;
