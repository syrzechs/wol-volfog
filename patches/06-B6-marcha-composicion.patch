+
+void VolFog::SetHardFailure(bool failed) {
+    s_hardFailure = failed;
+}
+
+bool VolFog::HardFailure() {
+    return s_hardFailure;
+}
+
+void VolFog::NoteDeviceRelease() {
+    s_deviceEpoch++;
+}
+
+uint32_t VolFog::DeviceEpoch() {
+    return s_deviceEpoch;
+}
