diff --git a/Shaders/VolFog/vf_ray_mask.hlsl b/Shaders/VolFog/vf_ray_mask.hlsl
new file mode 100644
index 0000000..a851ecf
--- /dev/null
+++ b/Shaders/VolFog/vf_ray_mask.hlsl
@@ -0,0 +1,43 @@
+#include "vf_common.hlsli"
+
+float4 cRayMask : register(c9);
+float4 cRaySource : register(c10);
+
+sampler2D sDepth : register(s0);
+sampler2D sDownsampledScene : register(s1);
+
+static const float3 kLumaWeights = float3(0.299, 0.587, 0.114);
+static const float kThresholdRampSlope = 4;
+
+float3 DirectionToSunView()
+{
+    return cRayMask.xyz;
+}
+
+float AngularFalloffExponent()
+{
+    return cRayMask.w;
+}
+
+float LuminanceThreshold()
+{
+    return cRaySource.y;
+}
+
+float2 RayTexelSize()
+{
+    return cRaySource.zw;
+}
+
+float4 main(float2 rayTexel : VPOS) : COLOR0
+{
+    float2 fullPixelsPerRayTexel = ViewportSize() * RayTexelSize();
+    float2 pixel = min(ViewportOrigin() + (rayTexel + 0.5) * fullPixelsPerRayTexel, ViewportLastPixelCentre());
+    float skyMask = IsSky(SampleDepth(sDepth, pixel)) ? 1 : 0;
+    float3 viewDirection = normalize(ViewRayAtUnitDepth(pixel));
+    float sunFalloff = pow(saturate(dot(viewDirection, DirectionToSunView())), AngularFalloffExponent());
+    float3 scene = tex2Dlod(sDownsampledScene, float4((rayTexel + 0.5) * RayTexelSize(), 0, 0)).rgb;
+    float luminance = dot(scene, kLumaWeights);
+    float brightSky = skyMask * sunFalloff * saturate((luminance - LuminanceThreshold()) * kThresholdRampSlope);
+    return float4(scene * brightSky, 1);
+}
diff --git a/Shaders/VolFog/vf_sample_split.hlsli b/Shaders/VolFog/vf_sample_split.hlsli
new file mode 100644
index 0000000..5451bef
--- /dev/null
+++ b/Shaders/VolFog/vf_sample_split.hlsli
@@ -0,0 +1,55 @@
+#include "vf_composite.hlsli"
+
+static const float kPlanarCurvatureShare = 0.25;
+
+struct DepthNeighbourhood
+{
+    float own;
+    float nearest;
+    float farthest;
+    float curvature;
+};
+
+float DepthAround(float2 pixel, float2 offset)
+{
+    return SampleDepth(sDepth, clamp(pixel + offset, ViewportOrigin() + 0.5, ViewportLastPixelCentre()));
+}
+
+float SecondDifference(float before, float own, float after)
+{
+    return abs(before + after - 2 * own);
+}
+
+DepthNeighbourhood NeighbourhoodOf(float2 pixel)
+{
+    float depth[3][3];
+    [unroll] for (int y = 0; y < 3; y++)
+        [unroll] for (int x = 0; x < 3; x++)
+            depth[y][x] = DepthAround(pixel, float2(x - 1, y - 1));
+    DepthNeighbourhood n;
+    n.own = depth[1][1];
+    n.nearest = min(min(min(depth[0][0], depth[0][1]), min(depth[0][2], depth[1][0])),
+                    min(min(depth[1][1], depth[1][2]), min(min(depth[2][0], depth[2][1]), depth[2][2])));
+    n.farthest = max(max(max(depth[0][0], depth[0][1]), max(depth[0][2], depth[1][0])),
+                     max(max(depth[1][1], depth[1][2]), max(max(depth[2][0], depth[2][1]), depth[2][2])));
+    n.curvature = max(max(SecondDifference(depth[1][0], n.own, depth[1][2]),
+                          SecondDifference(depth[0][1], n.own, depth[2][1])),
+                      max(SecondDifference(depth[0][0], n.own, depth[2][2]),
+                          SecondDifference(depth[0][2], n.own, depth[2][0])));
+    return n;
+}
+
+bool SilhouetteWithin(DepthNeighbourhood n)
+{
+    float nearestViewZ = LinearDepth(n.nearest);
+    float farthestViewZ = LinearDepth(n.farthest);
+    bool separated = farthestViewZ - nearestViewZ > max(kSameSurfaceAbsoluteDepth,
+                                                        nearestViewZ * kSameSurfaceRelativeDepth);
+    bool planar = n.curvature <= kPlanarCurvatureShare * (n.farthest - n.nearest);
+    return !SameDepthClass(n.nearest, n.farthest) || (separated && !planar);
+}
+
+float SplitDepth(DepthNeighbourhood n)
+{
+    return 0.5 * (n.nearest + n.farthest);
+}
diff --git a/Shaders/VolFog/vf_silhouette_mask.hlsl b/Shaders/VolFog/vf_silhouette_mask.hlsl
new file mode 100644
index 0000000..c8f9a3a
--- /dev/null
+++ b/Shaders/VolFog/vf_silhouette_mask.hlsl
@@ -0,0 +1,17 @@
+#include "vf_sample_split.hlsli"
+
+struct SilhouetteSplit
+{
+    float4 colour : COLOR0;
+    float depth : DEPTH;
+};
+
+SilhouetteSplit main(float2 pixelIndex : VPOS)
+{
+    DepthNeighbourhood n = NeighbourhoodOf(pixelIndex + 0.5);
+    clip(SilhouetteWithin(n) ? 1 : -1);
+    SilhouetteSplit output;
+    output.colour = 0;
+    output.depth = SplitDepth(n);
+    return output;
+}
diff --git a/Shaders/VolFog/vf_temporal.hlsl b/Shaders/VolFog/vf_temporal.hlsl
new file mode 100644
index 0000000..153db27
--- /dev/null
+++ b/Shaders/VolFog/vf_temporal.hlsl
@@ -0,0 +1,158 @@
+#include "vf_common.hlsli"
+
+row_major float4x4 cViewToPreviousClip : register(c9);
+float4 cTemporal : register(c13);
+
+sampler2D sCurrent : register(s0);
+sampler2D sHistory : register(s1);
+sampler2D sDepth : register(s2);
+sampler2D sHistoryDepth : register(s3);
+
+static const float kHistoryRelativeDepthTolerance = 0.02;
+static const float kHistoryAbsoluteDepthTolerance = 0.5;
+
+float HistoryWeight()
+{
+    return cTemporal.x;
+}
+
+bool HistoryInvalid()
+{
+    return cTemporal.y <= 0;
+}
+
+float LightingHistoryWeight(float3 current, float3 history)
+{
+    float weight = HistoryWeight();
+    [branch] if (cTemporal.z > 0)
+    {
+        float3 difference = abs(current - history);
+        float peakDifference = max(difference.r, max(difference.g, difference.b));
+        float3 peak = max(current, history);
+        float brightness = max(0.05, max(peak.r, max(peak.g, peak.b)));
+        weight *= 1 - smoothstep(0.20, 0.40, peakDifference / brightness);
+    }
+    return weight;
+}
+
+void CurrentNeighbourhoodRange(float2 uv, float4 centre, out float4 lowest, out float4 highest)
+{
+    lowest = centre;
+    highest = centre;
+    static const float2 kNeighbourOffsets[8] = {
+        float2(-1, -1), float2(0, -1), float2(1, -1), float2(-1, 0),
+        float2(1, 0), float2(-1, 1), float2(0, 1), float2(1, 1)
+    };
+    [unroll] for (int k = 0; k < 8; k++)
+    {
+        float4 neighbour = tex2Dlod(sCurrent, float4(uv + kNeighbourOffsets[k] * LowResTexelSize(), 0, 0));
+        lowest = min(lowest, neighbour);
+        highest = max(highest, neighbour);
+    }
+}
+
+bool MatchesSurface(float expectedDepth, float depthClass, float tapViewZ, float tapDepthClass)
+{
+    float tolerance = max(kHistoryAbsoluteDepthTolerance, expectedDepth * kHistoryRelativeDepthTolerance);
+    return abs(tapDepthClass - depthClass) < 0.25 && (depthClass > 0 || abs(tapViewZ - expectedDepth) <= tolerance);
+}
+
+float DepthClass(float depth)
+{
+    return IsSky(depth) ? 1 : (BeyondFarClip(depth) ? 0.5 : 0);
+}
+
+struct History
+{
+    float4 value;
+    bool found;
+};
+
+History NoHistory()
+{
+    History none;
+    none.value = 0;
+    none.found = false;
+    return none;
+}
+
+History ValidatedHistory(float2 uv, float expectedDepth, float depthClass)
+{
+    float2 texel = uv * LowResSize() - 0.5;
+    float2 baseTexel = floor(texel);
+    float2 fraction = texel - baseTexel;
+    static const float2 kOffsets[4] = {float2(0, 0), float2(1, 0), float2(0, 1), float2(1, 1)};
+    float4 history = 0;
+    float weightSum = 0;
+    [unroll] for (int i = 0; i < 4; ++i)
+    {
+        float2 tap = baseTexel + kOffsets[i];
+        float2 tapUv = LowResTexelToUv(clamp(tap, 0, LowResSize() - 1));
+        float3 previousDepth = tex2Dlod(sHistoryDepth, float4(tapUv, 0, 0)).rgb;
+        float previousViewZ = dot(previousDepth.rg, float2(65280, 255)) * (MaxFogDistance() / 65535);
+        float valid = MatchesSurface(expectedDepth, depthClass, previousViewZ, previousDepth.b) ? 1 : 0;
+        float2 bilinear = lerp(1 - fraction, fraction, kOffsets[i]);
+        float weight = bilinear.x * bilinear.y * valid;
+        history += tex2Dlod(sHistory, float4(tapUv, 0, 0)) * weight;
+        weightSum += weight;
+    }
+    History validated;
+    validated.found = weightSum > 1e-5;
+    validated.value = history / max(weightSum, 1e-5);
+    return validated;
+}
+
+History ReprojectedHistory(float2 pixel, float depth, float viewZ, float depthClass)
+{
+    [branch] if (HistoryInvalid())
+        return NoHistory();
+    float4 previousClip = mul(float4(ViewRayAtUnitDepth(pixel) * viewZ, IsSky(depth) ? 0 : 1),
+                              cViewToPreviousClip);
+    [branch] if (previousClip.w <= 1e-3)
+        return NoHistory();
+    float2 previousPixel = NdcToPixel(previousClip.xy / previousClip.w);
+    float2 previousUv = LowResTexelToUv(FullPixelToLowResTexel(previousPixel));
+    [branch] if (any(previousUv < 0) || any(previousUv > 1))
+        return NoHistory();
+    return ValidatedHistory(previousUv, previousClip.w, depthClass);
+}
+
+bool InsideLowResTarget(float2 lowResTexel)
+{
+    return all(lowResTexel >= 0) && all(lowResTexel < LowResSize());
+}
+
+float4 SameSurfaceCurrentAverage(float2 lowResTexel, float viewZ, float depthClass)
+{
+    float4 sum = 0;
+    float weightSum = 0;
+    [loop] for (int k = 0; k < 9; ++k)
+    {
+        float2 tap = lowResTexel + float2(k % 3, k / 3) - 1;
+        float tapDepth = SampleDepth(sDepth, LowResTexelToFullPixel(tap));
+        float weight = InsideLowResTarget(tap) &&
+                       MatchesSurface(viewZ, depthClass, LinearDepth(tapDepth), DepthClass(tapDepth)) ? 1 : 0;
+        sum += tex2Dlod(sCurrent, float4(LowResTexelToUv(tap), 0, 0)) * weight;
+        weightSum += weight;
+    }
+    return sum / max(weightSum, 1);
+}
+
+float4 main(float2 lowResTexel : VPOS) : COLOR0
+{
+    float2 uv = LowResTexelToUv(lowResTexel);
+    float2 pixel = LowResTexelToFullPixel(lowResTexel);
+    float depth = SampleDepth(sDepth, pixel);
+    float viewZ = LinearDepth(depth);
+    float depthClass = DepthClass(depth);
+    History reprojected = ReprojectedHistory(pixel, depth, viewZ, depthClass);
+    [branch] if (!reprojected.found)
+        return SameSurfaceCurrentAverage(lowResTexel, viewZ, depthClass);
+
+    float4 current = tex2Dlod(sCurrent, float4(uv, 0, 0));
+    float4 lowest;
+    float4 highest;
+    CurrentNeighbourhoodRange(uv, current, lowest, highest);
+    float4 history = clamp(reprojected.value, lowest, highest);
+    return lerp(current, history, LightingHistoryWeight(current.rgb, history.rgb));
+}
diff --git a/Tools/VolFog/mkbls.py b/Tools/VolFog/mkbls.py
new file mode 100644
index 0000000..02ac2bb
--- /dev/null
+++ b/Tools/VolFog/mkbls.py
@@ -0,0 +1,165 @@
+"""Packs compiled D3D9 shader bytecode (fxc /Fo output) into the GXSH ".bls" container of the WoW 3.3.5a client.
+
+Not in the original client (World of Legends): native volumetric fog (wolVolFog), brief B2. GPL-3.0-only (same licence
+as Shaders/VolFog); standard library only.
+
+usage: python -I mkbls.py <out.bls> <permutation0.pso> [<permutation1.pso> ...]
+       python -I mkbls.py --check <file.bls> [<file.bls> ...]
+
+Container (little-endian, CGxDevice::IShaderLoad + CGxShader::Load of the client):
+    u32 magic 'GXSH' (on disk 48 53 58 47)   u32 version 0x00010003   u32 N (number of permutations)
+    N entries: u32 unk_003C, u32 unk_0040, u16 unk_0044, u16 unk_0046, u32 codeSize, bytecode, padding to 4 bytes.
+
+The unk fields are read and kept by the client but nothing in it consumes them; the original files do not leave them at 0
+(checked against Terrain1, Combiners_Opaque, FFXBox4, FFXGlow, TerrainSM and the vs_3_0 Terrain, Diffuse_T1, ShadowMap
+of patch.MPQ / patch-2.MPQ), so they are reproduced from the bytecode:
+    unk_003C  bit mask of the inputs the shader declares (vertex shader: vertex attributes; pixel shader: interpolants)
+    unk_0040  bit mask of the outputs (vertex shader: interpolants written; pixel shader: 0x200 = colour 0)
+    unk_0044  pixel shader: bit mask of the samplers used (bit n = sN); vertex shader: 0
+    unk_0046  always 0
+    bit of a usage: position 0, blend weight 1, blend indices 2, normal 3, fog 7, colour n 9 + n, texcoord n 11 + n.
+"""
+import os
+import struct
+import sys
+
+MAGIC = 0x47585348      # 'GXSH'
+VERSION = 0x00010003
+
+D3DDECLUSAGE = {0: 'position', 1: 'blendweight', 2: 'blendindices', 3: 'normal', 4: 'psize', 5: 'texcoord',
+                6: 'tangent', 7: 'binormal', 8: 'tessfactor', 9: 'positiont', 10: 'color', 11: 'fog',
+                12: 'depth', 13: 'sample'}
+FIXED_BITS = {'position': 0, 'blendweight': 1, 'blendindices': 2, 'normal': 3, 'fog': 7}
+COLOR_BASE = 9
+TEXCOORD_BASE = 11
+
+REG_INPUT, REG_TEXTURE, REG_OUTPUT, REG_SAMPLER = 1, 3, 6, 10
+OP_DCL, OP_COMMENT, OP_END = 31, 0xFFFE, 0xFFFF
+
+
+def usage_bit(usage, index, where):
+    name = D3DDECLUSAGE.get(usage, 'usage %d' % usage)
+    if name in FIXED_BITS and index == 0:
+        return FIXED_BITS[name]
+    if name == 'color' and index < 2:
+        return COLOR_BASE + index
+    if name == 'texcoord' and index < 8:
+        return TEXCOORD_BASE + index
+    raise SystemExit('mkbls: %s %s%d has no known unk bit (not seen in the original .bls files); extend usage_bit()'
+                     % (where, name, index))
+
+
+def derive_unk(code):
+    """Returns (unk_003C, unk_0040, unk_0044, unk_0046, is_pixel) from D3D9 shader bytecode."""
+    if len(code) < 8 or len(code) % 4:
+        raise SystemExit('mkbls: bytecode size %d is not a multiple of 4 (is this an fxc /Fo output?)' % len(code))
+    tokens = struct.unpack('<%dI' % (len(code) // 4), code)
+    kind = tokens[0] >> 16
+    if kind not in (0xFFFF, 0xFFFE):
+        raise SystemExit('mkbls: bytecode does not start with a D3D9 version token (0x%08x)' % tokens[0])
+    is_pixel = kind == 0xFFFF
+    major = (tokens[0] >> 8) & 0xFF
+    inputs = outputs = samplers = 0
+    pos = 1
+    ended = False
+    while pos < len(tokens):
+        token = tokens[pos]
+        op = token & 0xFFFF
+        if op == OP_END:
+            ended = True
+            break
+        if op == OP_COMMENT:
+            pos += 1 + ((token >> 16) & 0x7FFF)
+            continue
+        length = (token >> 24) & 0xF
+        if op == OP_DCL:
+            decl, dest = tokens[pos + 1], tokens[pos + 2]
+            reg_type = ((dest >> 28) & 7) | ((dest >> 8) & 0x18)
+            reg_num = dest & 0x7FF
+            usage, index = decl & 0x1F, (decl >> 16) & 0xF
+            if reg_type == REG_SAMPLER:
+                samplers |= 1 << reg_num
+            elif reg_type == REG_INPUT:
+                if is_pixel and major < 3:
+                    inputs |= 1 << (COLOR_BASE + reg_num)       # ps_2_x: v# are the colour registers
+                else:
+                    inputs |= 1 << usage_bit(usage, index, 'input')
+            elif reg_type == REG_TEXTURE and is_pixel:
+                inputs |= 1 << (TEXCOORD_BASE + reg_num)        # ps_2_x: t# are the texcoord registers
+            elif reg_type == REG_OUTPUT and not is_pixel:
+                outputs |= 1 << usage_bit(usage, index, 'output')
+        pos += 1 + length
+    if not ended:
+        raise SystemExit('mkbls: bytecode has no end token')
+    if is_pixel:
+        outputs = 1 << COLOR_BASE   # colour 0; every original pixel shader writes exactly this
+    else:
+        samplers = 0
+    return inputs, outputs, samplers, 0, is_pixel
+
+
+def build(out_path, pso_paths):
+    entries = []
+    for path in pso_paths:
+        with open(path, 'rb') as f:
+            code = f.read()
+        in_mask, out_mask, sampler_mask, unk46, is_pixel = derive_unk(code)
+        entries.append(struct.pack('<IIHHI', in_mask, out_mask, sampler_mask, unk46, len(code)) + code
+                       + b'\0' * (-len(code) % 4))
+    data = struct.pack('<III', MAGIC, VERSION, len(entries)) + b''.join(entries)
+    with open(out_path, 'wb') as f:
+        f.write(data)
+    print('mkbls: %s: %d permutation(s), %d bytes' % (out_path, len(entries), len(data)))
+
+
+def check(path):
+    """Opens a .bls with the same steps as CGxDevice::IShaderLoad and compares the unk fields with the bytecode."""
+    with open(path, 'rb') as f:
+        data = f.read()
+    path = os.path.basename(path)
+    if len(data) < 12:
+        print('%s: %d bytes, not a GXSH file (the client treats it as a missing shader)' % (path, len(data)))
+        return False
+    ok = True
+    magic, version, count = struct.unpack_from('<III', data, 0)
+    if magic != MAGIC or version != VERSION:
+        print('%s: BAD header magic=%08x version=%08x' % (path, magic, version))
+        return False
+    pos = 12
+    mismatches = 0
+    for i in range(count):
+        if pos + 16 > len(data):
+            print('%s: entry %d truncated' % (path, i))
+            return False
+        u3c, u40, u44, u46, size = struct.unpack_from('<IIHHI', data, pos)
+        pos += 16
+        code = data[pos:pos + size]
+        if len(code) != size:
+            print('%s: entry %d bytecode truncated' % (path, i))
+            return False
+        pos += (size + 3) & ~3
+        try:
+            d3c, d40, d44, d46, _ = derive_unk(code)
+        except SystemExit as exc:
+            print('%s: entry %d: %s' % (path, i, exc))
+            ok = False
+            continue
+        if (u3c, u40, u44, u46) != (d3c, d40, d44, d46):
+            mismatches += 1
+            print('%s: entry %d unk stored %05x/%05x/%04x/%04x derived %05x/%05x/%04x/%04x'
+                  % (path, i, u3c, u40, u44, u46, d3c, d40, d44, d46))
+    if pos != len(data):
+        print('%s: %d unread bytes after %d entries' % (path, len(data) - pos, count))
+        ok = False
+    print('%s: GXSH v%08x, %d permutation(s), %d bytes, unk fields %s' % (
+        path, version, count, len(data), 'all match the bytecode' if not mismatches else '%d MISMATCH' % mismatches))
+    return ok and not mismatches
+
+
+if __name__ == '__main__':
+    if len(sys.argv) >= 3 and sys.argv[1] == '--check':
+        results = [check(p) for p in sys.argv[2:]]
+        sys.exit(0 if all(results) else 1)
+    if len(sys.argv) < 3:
+        sys.exit(__doc__)
+    build(sys.argv[1], sys.argv[2:])
diff --git a/Tools/VolFog/mkmpq.py b/Tools/VolFog/mkmpq.py
new file mode 100644
index 0000000..486d83f
--- /dev/null
+++ b/Tools/VolFog/mkmpq.py
@@ -0,0 +1,118 @@
+"""Minimal MPQ (format v1) writer for small interface patches of the WoW 3.3.5a client.
+
+usage: python -I mkmpq.py <output.MPQ> <root_dir> <file inside root> [<file> ...]
+
+Each file is stored under its path relative to <root_dir> (with backslashes, e.g. Interface\\GlueXML\\AccountLogin.lua),
+zlib-compressed in 4096-byte sectors with a sector offset table, locale neutral, not encrypted. A (listfile) is added.
+Hash and block tables are encrypted as the format requires. No external dependencies.
+"""
+import os
+import struct
+import sys
+import zlib
+
+MPQ_FILE_COMPRESS = 0x00000200
+MPQ_FILE_EXISTS = 0x80000000
+SECTOR_SHIFT = 3  # 512 << 3 = 4096
+
+
+def _crypt_table():
+    table = [0] * 0x500
+    seed = 0x00100001
+    for index1 in range(0x100):
+        index2 = index1
+        for _ in range(5):
+            seed = (seed * 125 + 3) % 0x2AAAAB
+            temp1 = (seed & 0xFFFF) << 0x10
+            seed = (seed * 125 + 3) % 0x2AAAAB
+            temp2 = seed & 0xFFFF
+            table[index2] = temp1 | temp2
+            index2 += 0x100
+    return table
+
+
+CRYPT = _crypt_table()
+
+
+def hash_string(name, hash_type):
+    seed1, seed2 = 0x7FED7FED, 0xEEEEEEEE
+    for ch in name.replace('/', '\\').upper().encode('ascii'):
+        value = CRYPT[(hash_type << 8) + ch]
+        seed1 = (value ^ (seed1 + seed2)) & 0xFFFFFFFF
+        seed2 = (ch + seed1 + seed2 + (seed2 << 5) + 3) & 0xFFFFFFFF
+    return seed1
+
+
+def encrypt(data, key):
+    assert len(data) % 4 == 0
+    seed1, seed2 = key, 0xEEEEEEEE
+    out = []
+    for (value,) in struct.iter_unpack('<I', data):
+        seed2 = (seed2 + CRYPT[0x400 + (seed1 & 0xFF)]) & 0xFFFFFFFF
+        out.append((value ^ (seed1 + seed2)) & 0xFFFFFFFF)
+        seed1 = (((~seed1 << 0x15) + 0x11111111) | (seed1 >> 0x0B)) & 0xFFFFFFFF
+        seed2 = (value + seed2 + (seed2 << 5) + 3) & 0xFFFFFFFF
+    return struct.pack('<%dI' % len(out), *out)
+
+
+def pack_file(data):
+    sector_size = 512 << SECTOR_SHIFT
+    sectors = [data[i:i + sector_size] for i in range(0, len(data), sector_size)] or [b'']
+    blobs = []
+    for sector in sectors:
+        packed = b'\x02' + zlib.compress(sector, 9)  # 0x02 = zlib
+        blobs.append(packed if len(packed) < len(sector) else sector)
+    offsets = [(len(sectors) + 1) * 4]
+    for blob in blobs:
+        offsets.append(offsets[-1] + len(blob))
+    return struct.pack('<%dI' % len(offsets), *offsets) + b''.join(blobs)
+
+
+def build(output, root, files):
+    entries = []
+    for path in files:
+        rel = os.path.relpath(path, root).replace('/', '\\')
+        with open(path, 'rb') as f:
+            entries.append((rel, f.read()))
+    listfile = ''.join(name + '\r\n' for name, _ in entries).encode('ascii')
+    entries.append(('(listfile)', listfile))
+
+    hash_size = 16
+    while hash_size < len(entries) * 2:
+        hash_size *= 2
+
+    body = bytearray()
+    blocks = []
+    header_size = 32
+    for name, data in entries:
+        packed = pack_file(data)
+        blocks.append((header_size + len(body), len(packed), len(data), MPQ_FILE_EXISTS | MPQ_FILE_COMPRESS))
+        body += packed
+
+    hash_table = [(0xFFFFFFFF, 0xFFFFFFFF, 0xFFFF, 0xFFFF, 0xFFFFFFFF)] * hash_size
+    for block_index, (name, _) in enumerate(entries):
+        index = hash_string(name, 0) & (hash_size - 1)
+        while hash_table[index][4] != 0xFFFFFFFF:
+            index = (index + 1) & (hash_size - 1)
+        hash_table[index] = (hash_string(name, 1), hash_string(name, 2), 0, 0, block_index)
+
+    hash_raw = b''.join(struct.pack('<IIHHI', *e) for e in hash_table)
+    block_raw = b''.join(struct.pack('<IIII', *b) for b in blocks)
+    hash_offset = header_size + len(body)
+    block_offset = hash_offset + len(hash_raw)
+    archive_size = block_offset + len(block_raw)
+
+    header = struct.pack('<4sIIHHIIII', b'MPQ\x1a', header_size, archive_size, 0, SECTOR_SHIFT,
+                         hash_offset, block_offset, hash_size, len(blocks))
+    with open(output, 'wb') as f:
+        f.write(header)
+        f.write(body)
+        f.write(encrypt(hash_raw, hash_string('(hash table)', 3)))
+        f.write(encrypt(block_raw, hash_string('(block table)', 3)))
+    for name, data in entries:
+        print('  %-45s %6d bytes' % (name, len(data)))
+    print('wrote %s (%d bytes)' % (output, archive_size))
+
+
+if __name__ == '__main__':
+    build(sys.argv[1], sys.argv[2], sys.argv[3:])
