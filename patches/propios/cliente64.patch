         if (pass == 0) {
+#if defined(WOWDECOMP_ARCH_64)
+            // Not in the original client (World of Legends): the 64-bit client also reads every Data\WoL64\*.MPQ (the
+            // "remember password" GlueXML, the volumetric fog shaders, future packages). They go into the list that is
+            // sorted just below: "Data\WoL64\..." sorts above "Data\patch-Y.MPQ" and "Data\<locale>\patch-<locale>-3.MPQ"
