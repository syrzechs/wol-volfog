diff --git a/WoW/Source/Client_CVar.cpp b/WoW/Source/Client_CVar.cpp
index ff9609c..2de2ef1 100644
--- a/WoW/Source/Client_CVar.cpp
+++ b/WoW/Source/Client_CVar.cpp
@@ -639,6 +639,24 @@ bool LocaleCallback(CVar* var, const char* oldValue, const char* value, void* ar
     return true;
 }
 
+// Not in the original client (World of Legends): build string for support, "WoL64 <build date>+<git hash>". CMake injects
+// WOL_BUILD_DATE and WOL_BUILD_HASH (see the top CMakeLists.txt); without them the string says unknown / nogit. The same
+// text goes to the wolBuild CVar, the first line of WowClient_crash.log and a line of Logs\gx.log.
+#ifndef WOL_BUILD_DATE
+#define WOL_BUILD_DATE "unknown"
+#endif
+#ifndef WOL_BUILD_HASH
+#define WOL_BUILD_HASH "nogit"
+#endif
+const char g_wolBuildString[] = "WoL64 " WOL_BUILD_DATE "+" WOL_BUILD_HASH;
+
+// Not in the original client (World of Legends): wolBuild is read-only. The only value it accepts is the build string
+// itself (CVar::Register, Reset and Default hand it back); anything else, from /console, Lua or Config.wtf, is dropped
+// and the CVar keeps its value. It equals the default, so CVar::SaveAll never writes it to Config.wtf.
+static bool WolBuildCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    return value && !SStrCmp(value, g_wolBuildString, STORM_MAX_STR);
+}
+
