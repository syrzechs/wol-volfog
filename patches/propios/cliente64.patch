     g_savedPasswordVar = CVar::Register("savedPassword", "Saved account password (obfuscated, not encrypted)", 0x40, "", nullptr, CATEGORY_GAME, false, nullptr, false);
+    // Not in the original client (World of Legends): read-only build string (flag 0x100: "is read only" in the console).
+    CVar::Register("wolBuild", "Build of the World of Legends 64-bit client (read-only)", 0x100, g_wolBuildString, WolBuildCallback, CATEGORY_GAME, false, nullptr, false);
     s_cvMovie = CVar::Register("movie", "Show movie on startup", 0, "1", nullptr, CATEGORY_GAME, false, nullptr, false);
     s_cvExpansionMovie = CVar::Register("expansionMovie", "Show expansion movie on startup", 0, "1", nullptr, CATEGORY_GAME, false, nullptr, false);
     s_cvMovieSubtitle = CVar::Register("movieSubtitle", "Show movie subtitles", 0, "0", nullptr, CATEGORY_GAME, false, nullptr, false);
diff --git a/WoW/Source/WowServices/PatchFiles.cpp b/WoW/Source/WowServices/PatchFiles.cpp
