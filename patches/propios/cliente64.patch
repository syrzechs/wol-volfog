diff --git a/CMakeLists.txt b/CMakeLists.txt
index fc42b44..c9a1f2d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -54,6 +54,29 @@ if (WOWDECOMP_DISABLE_SIGNATURE_CHECKS)
     add_compile_definitions(DISABLE_SIGNATURE_CHECKS=1)
 endif ()
 
+# Not in the original client (World of Legends): build string of the wolBuild CVar, "WoL64 <date>+<git hash>", also written to
+# WowClient_crash.log and Logs/gx.log. Taken when CMake configures (run cmake again to refresh it); git missing gives "nogit".
+# Only WoW/Source/Client_CVar.cpp gets the definitions (see WoW/Source and Tools/WowClient), so a new day does not rebuild
+# the whole client.
+string(TIMESTAMP WOL_BUILD_DATE "%Y-%m-%d")
+set(WOL_BUILD_HASH "nogit")
+find_package(Git QUIET)
+if (GIT_FOUND)
+    execute_process(
+        COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
+        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
+        OUTPUT_VARIABLE WOL_GIT_HASH
+        RESULT_VARIABLE WOL_GIT_RESULT
+        ERROR_QUIET
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+    )
+    if (WOL_GIT_RESULT EQUAL 0 AND WOL_GIT_HASH)
+        string(SUBSTRING "${WOL_GIT_HASH}" 0 7 WOL_BUILD_HASH)
+    endif ()
+endif ()
+set(WOL_BUILD_COMPILE_DEFINITIONS "WOL_BUILD_DATE=\"${WOL_BUILD_DATE}\"" "WOL_BUILD_HASH=\"${WOL_BUILD_HASH}\"")
+message(STATUS "wolBuild: WoL64 ${WOL_BUILD_DATE}+${WOL_BUILD_HASH}")
+
 # Third-party code is linked, not decompiled, for now.
 if (EXISTS ${CMAKE_SOURCE_DIR}/ThirdParty/CMakeLists.txt)
     add_subdirectory(ThirdParty)
