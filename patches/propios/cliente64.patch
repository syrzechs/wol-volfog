@@ -6,6 +6,9 @@
 #include <cstdio>
 #include <cstring>
 
+// Not in the original client (World of Legends): "WoL64 YYYY-MM-DD+hash", defined in WoW/Source/Client_CVar.cpp.
+extern const char g_wolBuildString[];
+
 static char s_logPath[MAX_PATH];
 static HANDLE s_console = INVALID_HANDLE_VALUE;
 static HANDLE s_logFile = INVALID_HANDLE_VALUE;
@@ -140,6 +143,15 @@ static struct CrashLogInit {
         DeleteFileA(s_logPath);
         s_logFile = CreateFileA(s_logPath, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
 
+        // Not in the original client (World of Legends): the build string is the first line of the log, so a crash report
