+bool CWorldParam::WolAOCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    if (!value || value[0] < '0' || value[0] > '2' || value[1] != '\0') {
+        ConsoleWrite("wolAO must be 0 (off), 1 (half resolution, 4 steps) or 2 (half resolution, 6 steps, wider blur).", DEFAULT_COLOR);
