+        static const char* const s_names[3] = { "off", "half resolution, 4 steps", "half resolution, 6 steps, wider blur" };
+        char buffer[112];
+        SStrPrintf(buffer, sizeof(buffer), "wolAO: %d (%s)", mode, s_names[mode]);
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+        CGxDevice::Log("%s", static_cast<const char*>(buffer));
+
+        if (g_theGxDevicePtr) {
+            if (mode > 0 && !VolFog::s_caps.intz) {
+                static const char* const s_noIntz = "wolAO: this video card does not report INTZ, the ambient occlusion stays off.";
+                ConsoleWrite(s_noIntz, DEFAULT_COLOR);
+                CGxDevice::Log("%s", s_noIntz);
