+#include "Engine/Source/WolAO/WolAO.h"
+#include "Engine/Source/WolAO/WolAOInternal.h"
+#include "Engine/Source/VolFog/VolFog.h"
+
+// Not in the original client (World of Legends): native ambient occlusion (wolAO), brief E2. The settings of the CVars and the choice between the
+// mid frame and the late frame position; the passes are in WolAORender.cpp.
+
+namespace {
+    WolAO::Settings s_settings;
+    uint32_t s_generation;      // bumped by SetMode / SetDebug: a change of a CVar gives the pass a clean slate after a failure
+}
+
+const WolAO::Settings& WolAO::GetSettings() {
+    return s_settings;
+}
+
+void WolAO::SetMode(int32_t value) {
+    s_settings.mode = value;
+    VolFog::s_aoMode = value; // the INTZ depth is armed with wolAO > 0, like with wolVolFog > 0
+    s_generation++;
+}
+
+void WolAO::SetRadius(float value) {
+    s_settings.radius = value;
+}
+
+void WolAO::SetStrength(float value) {
+    s_settings.strength = value;
+}
+
+void WolAO::SetDebug(int32_t value) {
+    s_settings.debug = value;
+    s_generation++;
+}
+
+bool WolAO::Active() {
+    return s_settings.mode > 0;
+}
+
+uint32_t WolAO::Generation() {
+    return s_generation;
+}
+
+// aoLate of the design: the depth is a RESZ copy of the multisampled one (the copy costs a resolve) and the fog is on (it resolves too, late).
+bool WolAO::LateMode() {
+    return VolFog::DepthIsCopy() && VolFog::s_mode > 0;
+}
+
+void WolAO::RenderMid() {
+    if (WolAO::Active() && !WolAO::LateMode()) {
+        WolAO::Draw(false);
+    } else if (!WolAO::Active()) {
+        WolAO::Idle();
+    }
+}
+
+void WolAO::RenderLate() {
+    if (WolAO::Active() && WolAO::LateMode()) {
+        WolAO::Draw(true);
+    }
+}
diff --git a/Engine/Source/WolAO/WolAO.h b/Engine/Source/WolAO/WolAO.h
