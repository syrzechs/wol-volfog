+++ b/Engine/Source/WolAO/WolAO.h
@@ -0,0 +1,36 @@
+#ifndef ENGINE_SOURCE_WOLAO_WOLAO_H
+#define ENGINE_SOURCE_WOLAO_WOLAO_H
+
+#include <cstdint>
+
+// Not in the original client (World of Legends): native ambient occlusion (HBAO at half resolution over the INTZ depth), brief E2.
+// Licensed under GPL-3.0-only. Shaders/WolAO/WolAO.hlsl implements the occlusion term of the horizon-based family from the published paper.
+
+namespace WolAO {
+    // The CVars of the pass (WorldParam_CVar.cpp validates them and writes here; Render* reads them every frame, so a change applies at once,
+    // except that going between wolAO 0 and above 0 needs a gxRestart when the readable depth was not armed: see VolFog::NoteDepthWantChanged).
+    struct Settings {
+        int32_t mode = 0;           // wolAO 0-2: 0 off, 1 half resolution with 4 steps per direction, 2 half resolution with 6 steps and a wider blur
+        float radius = 1.5f;        // wolAORadius 0.5-4.0 yards
+        float strength = 1.0f;      // wolAOStrength 0.0-2.0
+        int32_t debug = 0;          // wolAODebug 0-3: 0 off, 1 the multiplier in grey, 2 the raw AO (no blur), 3 the normals rebuilt from the depth
+    };
+
+    const Settings& GetSettings();
+    // Also writes VolFog::s_aoMode: the readable depth belongs to the fog module.
+    void SetMode(int32_t value);
+    void SetRadius(float value);
+    void SetStrength(float value);
+    void SetDebug(int32_t value);
+
+    // True when Render* has something to draw (wolAO above 0).
+    bool Active();
+
+    // The AO runs "mid frame" (RenderMid, right after RenderDetailDoodads: before the water, the transparent M2s, the weather and the particles, so
+    // those are not darkened) unless the depth is a RESZ copy of the multisampled depth and the fog is on: then it runs "late" (RenderLate, right
+    // before VolFog::Render) and shares the one resolve of the frame with it. Exactly one of the two draws in a given frame.
+    void RenderMid();
+    void RenderLate();
+}
+
+#endif
