--- /dev/null
+++ b/Shaders/WolAO/WolAO.cmake
@@ -0,0 +1,8 @@
+# Not in the original client (World of Legends): the shaders of the native ambient occlusion WolAO (wolAO), brief E2.
+# Included by Shaders/VolFog/CMakeLists.txt right before the patch-Z.MPQ command, like WolPost.cmake: same chain (volfog_shader: fxc ->
+# Tools/VolFog/mkbls.py -> Tools/VolFog/mkmpq.py), same MPQ. CMAKE_CURRENT_SOURCE_DIR is Shaders/VolFog here, hence the ../WolAO.
+# One source, three passes (/D PASS=0|1|2). Permutations: WolAO QUALITY 1 / 2 (index quality - 1); WolAOBlur WIDE 0 / 1; WolAOComposite DEBUG 0..3.
+# The vertex shader is the quad one of the fog (WolVolFogQuad, vf_fullscreen_vs.hlsl).
+volfog_shader(WolAO ps ../WolAO/WolAO.hlsl PERMUTATIONS "PASS=0,QUALITY=1" "PASS=0,QUALITY=2")
+volfog_shader(WolAOBlur ps ../WolAO/WolAO.hlsl PERMUTATIONS "PASS=1,WIDE=0" "PASS=1,WIDE=1")
+volfog_shader(WolAOComposite ps ../WolAO/WolAO.hlsl PERMUTATIONS "PASS=2,DEBUG=0" "PASS=2,DEBUG=1" "PASS=2,DEBUG=2" "PASS=2,DEBUG=3")
diff --git a/Shaders/WolAO/WolAO.hlsl b/Shaders/WolAO/WolAO.hlsl
new file mode 100644
index 0000000..a09942c
--- /dev/null
+++ b/Shaders/WolAO/WolAO.hlsl
@@ -0,0 +1,240 @@
+// Not in the original client (World of Legends): pixel shaders of the native ambient occlusion WolAO (wolAO), brief E2.
+// Written for this project (GPL-3.0-only like the rest of the client changes). The occlusion term per sample is the one of the horizon-based
+// family (Bavoil and Sainz, "Image-space horizon-based ambient occlusion", 2008, and the normal-oriented variants that followed):
+//   occlusion(sample) = saturate(dot(N, V) / |V| - bias) * saturate(1 - |V|^2 / R^2),   V = (position of the sample) - (position of the pixel)
+// implemented from the paper, not copied from the code of any SDK. One source, three passes, selected with /D PASS=0|1|2:
+//   PASS 0  WolAO.bls           /D QUALITY=1|2  AO at half resolution: 8 directions x 4 (QUALITY 1) or 6 (QUALITY 2) steps from the INTZ depth,
+//                                               normal rebuilt from the depth (the neighbour with the smaller depth difference on each axis, so a
+//                                               silhouette gives no halo), a rotation and a step jitter per pixel from interleaved gradient noise
+//                                               (Jimenez, 2014). Output R = AO (1 = open), G = view depth in yards (sky 10000).
+//   PASS 1  WolAOBlur.bls       /D WIDE=0|1     separable bilateral blur of the low resolution AO, 9 taps (WIDE=0) or 13 taps (WIDE=1); the step of
+//                                               the pass (horizontal or vertical) comes in c7.xy; the weights fall with the difference of view depth.
+//   PASS 2  WolAOComposite.bls  /D DEBUG=0..3   full resolution: bilateral up-sampling of the four nearest low resolution texels by the view depth of
+//                                               the pixel, fade with the distance and with the linear fog of the client, and the result as a grey
+//                                               multiplier (black with alpha = 1 - multiplier, drawn with GxBlend_Alpha: dest * multiplier). Sky and beyond the
+//                                               world (depth >= 0.95) is left alone. DEBUG 1 = the multiplier in grey (opaque blend), 2 = the raw AO
+//                                               before the blur, 3 = the normal rebuilt from the depth.
+// Register contract (the same registers as the fog where they coincide):
+//   c0 world viewport in pixels (x, y, w, h), c1 (1 / low width, 1 / low height, 1 / INTZ width, 1 / INTZ height), c2 cViewToNdc, c3 cDepthToViewZ,
+//   c4 (R yards, 1 / R^2, bias, strength * gain / samples), c5 (largest radius in pixels, -, fade start yards, 1 / (fade end - fade start)),
+//   c6 (fog x, fog y, use fog 0 / 1, -), c7 (blur step x, blur step y, sharpness, -).  s0 = INTZ depth (POINT), s1 = AO (POINT).
+#ifndef PASS
+#error PASS must be 0, 1 or 2
+#endif
+
+float4 cViewportPx : register(c0);
+float4 cPixelGrid : register(c1);
+float4 cViewToNdc : register(c2);
+float4 cDepthToViewZ : register(c3);
+float4 cAO : register(c4);
+float4 cLimits : register(c5);
+float4 cFog : register(c6);
+float4 cBlur : register(c7);
+sampler2D sDepth : register(s0);
+sampler2D sAO : register(s1);
+
+static const float kSkyMinDepth = 0.95;   // the world uses the depth range 0..0.94: the sky is always above this (design 1.1)
+static const float kSkyViewZ = 10000.0;   // what a sky pixel reports as view depth (still a finite half float)
+
+#if PASS == 0 || (PASS == 2 && DEBUG == 3)
+// View depth in yards of an INTZ value: depth = x + y / viewZ with y < 0 (LinearDepth of vf_common.hlsli).
+float ViewZ(float depth)
+{
+    float denominator = depth - cDepthToViewZ.x;
+    return (depth >= kSkyMinDepth || denominator > -1e-6) ? kSkyViewZ : min(cDepthToViewZ.y / denominator, kSkyViewZ);
+}
+
+// `rel`: pixel centre in pixels from the top left corner of the world viewport.
+float SampleZ(float2 rel)
+{
+    rel = clamp(rel, 0.5, cViewportPx.zw - 0.5);
+    return ViewZ(tex2Dlod(sDepth, float4((cViewportPx.xy + rel) * cPixelGrid.zw, 0, 0)).r);
+}
+
+// Position in view space (x right, y up, z forward) of the pixel at `rel` seen at view depth z.
+float3 ViewPos(float2 rel, float z)
+{
+    float2 ndc = float2(rel.x / cViewportPx.z * 2 - 1, 1 - rel.y / cViewportPx.w * 2);
+    return float3((ndc - cViewToNdc.zw) / cViewToNdc.xy, 1) * z;
+}
+
+// Normal of the surface from the depth: the difference to the neighbour (left or right, up or down) with the smaller depth step.
+float3 RebuildNormal(float2 rel, float zc, float3 pc)
+{
+    float zr = SampleZ(rel + float2(1, 0));
+    float zl = SampleZ(rel - float2(1, 0));
+    float zd = SampleZ(rel + float2(0, 1));
+    float zu = SampleZ(rel - float2(0, 1));
+    float3 dx = abs(zr - zc) < abs(zl - zc) ? ViewPos(rel + float2(1, 0), zr) - pc : pc - ViewPos(rel - float2(1, 0), zl);
+    float3 dy = abs(zd - zc) < abs(zu - zc) ? ViewPos(rel + float2(0, 1), zd) - pc : pc - ViewPos(rel - float2(0, 1), zu);
+    return normalize(cross(dx, dy)); // dx runs to the right and dy down the screen: the normal faces the camera
+}
+#endif
+
+#if PASS == 0
+#ifndef QUALITY
+#error QUALITY must be 1 or 2
+#endif
+#define DIRECTIONS 8
+#if QUALITY == 1
+#define STEPS 4
+#else
+#define STEPS 6
+#endif
+
+float Ign(float2 p)
+{
+    return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));
+}
+
+float4 main(float2 vpos : VPOS) : COLOR0
+{
+    // The low resolution texel is the full resolution pixel (2x, 2y); `rel` is its centre.
+    float2 rel = min(vpos * 2.0 + 0.5, cViewportPx.zw - 0.5);
+    float zc = SampleZ(rel);
+    float4 result = float4(1, zc, 0, 1);
+
+    if (zc >= kSkyViewZ)
+    {
+        return result;
+    }
+
+    // Radius of the sphere of influence on the screen: yards * (projection scale * half the width) / depth; under 2 pixels there is nothing to see.
+    float radiusPx = min(cAO.x * cViewToNdc.x * 0.5 * cViewportPx.z / zc, cLimits.x);
+
+    if (radiusPx < 2.0)
+    {
+        return result;
+    }
+
+    float3 pc = ViewPos(rel, zc);
+    float3 normal = RebuildNormal(rel, zc, pc);
+    float rotation = Ign(vpos);
+    float jitter = Ign(float2(vpos.y + 7.0, vpos.x * 1.7 + 3.0));
+    float sum = 0;
+
+    [loop] for (int i = 0; i < DIRECTIONS; i++)
+    {
+        float angle = (i + rotation) * (6.2831853 / DIRECTIONS);
+        float2 dir;
+        sincos(angle, dir.y, dir.x);
+
+        [loop] for (int s = 0; s < STEPS; s++)
+        {
+            float2 at = rel + dir * max(radiusPx * ((s + jitter) * (1.0 / STEPS)), 1.5);
+            float zs = SampleZ(at);
+            float3 v = ViewPos(at, zs) - pc;
+            float vv = dot(v, v);
+            sum += saturate(dot(normal, v) * rsqrt(vv + 1e-4) - cAO.z) * saturate(1 - vv * cAO.y);
+        }
+    }
+
+    result.x = saturate(1 - sum * cAO.w);
+
+    return result;
+}
+
+#elif PASS == 1
+#ifndef WIDE
+#error WIDE must be 0 or 1
+#endif
+#if WIDE
+#define TAPS 6
+static const float kSigma = 3.5;
+#else
+#define TAPS 4
+static const float kSigma = 2.5;
+#endif
+
+float4 main(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cPixelGrid.xy;
+    float4 centre = tex2Dlod(sAO, float4(uv, 0, 0));
+    float sum = centre.x;
+    float weights = 1.0;
+
+    [unroll] for (int i = 1; i <= TAPS; i++)
+    {
+        float gauss = exp(-0.5 * i * i / (kSigma * kSigma));
+        float4 a = tex2Dlod(sAO, float4(uv + cBlur.xy * i, 0, 0));
+        float4 b = tex2Dlod(sAO, float4(uv - cBlur.xy * i, 0, 0));
+        float wa = gauss * exp(-abs(a.y - centre.y) / centre.y * cBlur.z);
+        float wb = gauss * exp(-abs(b.y - centre.y) / centre.y * cBlur.z);
+        sum += a.x * wa + b.x * wb;
+        weights += wa + wb;
+    }
+
+    return float4(sum / weights, centre.y, 0, 1);
+}
+
+#else
+#ifndef DEBUG
+#error DEBUG must be 0, 1, 2 or 3
+#endif
+
+float4 main(float2 vpos : VPOS) : COLOR0
+{
+    float2 rel = vpos - cViewportPx.xy + 0.5;
+
+#if DEBUG == 2
+    // The raw AO, no blur and no up-sampling: the low resolution texel that covers this pixel.
+    float raw = tex2Dlod(sAO, float4((floor(rel * 0.5) + 0.5) * cPixelGrid.xy, 0, 0)).x;
+    return float4(raw, raw, raw, 1);
+#else
+    float zc = tex2Dlod(sDepth, float4((vpos + 0.5) * cPixelGrid.zw, 0, 0)).r;
+    float denominator = zc - cDepthToViewZ.x;
+    bool sky = zc >= kSkyMinDepth || denominator > -1e-6;
+    float viewZ = sky ? kSkyViewZ : min(cDepthToViewZ.y / denominator, kSkyViewZ);
+
+#if DEBUG == 3
+    if (sky)
+    {
+        return float4(0, 0, 0, 1);
+    }
+
+    float3 n = RebuildNormal(rel, viewZ, ViewPos(rel, viewZ));
+    return float4(n * 0.5 + 0.5, 1);
+#else
+    float multiplier = 1.0;
+
+    if (!sky)
+    {
+        // The AO texel i was computed at the full resolution pixel 2i, so the pixel with index p = rel - 0.5 sits at i = p / 2.
+        float2 u = (rel - 0.5) * 0.5;
+        float2 base = floor(u);
+        float2 f = u - base;
+        float sum = 0;
+        float weights = 0;
+
+        [unroll] for (int k = 0; k < 4; k++)
+        {
+            float2 corner = float2((k == 1 || k == 3) ? 1.0 : 0.0, k >= 2 ? 1.0 : 0.0); // ps_3_0 has no bitwise operators
+            float2 axis = lerp(1 - f, f, corner);
+            float4 tap = tex2Dlod(sAO, float4((base + corner + 0.5) * cPixelGrid.xy, 0, 0));
+            float w = axis.x * axis.y * max(exp(-abs(tap.y - viewZ) / viewZ * cBlur.z), 1e-3);
+            sum += tap.x * w;
+            weights += w;
+        }
+
+        float ao = sum / max(weights, 1e-6);
+        float weight = saturate(1 - (viewZ - cLimits.z) * cLimits.w);
+
+        if (cFog.z > 0.5)
+        {
+            weight *= saturate(cFog.x * viewZ + cFog.y); // the linear fog of the client is already in the scene: no AO on what fades into it
+        }
+
+        multiplier = lerp(1, ao, weight);
+    }
+
+#if DEBUG == 1
+    return float4(multiplier, multiplier, multiplier, 1); // opaque view of the multiplier
+#else
+    // The pass is drawn with the alpha blend (SRCALPHA, INVSRCALPHA): black with alpha = 1 - multiplier gives dest * multiplier, the same as
+    // DESTCOLOR * src + 0 (GxBlend_Mod) without relying on the destination colour factor.
+    return float4(0, 0, 0, 1.0 - multiplier);
+#endif
+#endif
+#endif
+}
+#endif
