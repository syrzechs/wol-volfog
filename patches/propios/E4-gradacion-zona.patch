--- /dev/null
+++ b/WoW/Source/WorldClient/WolPostWorld.cpp
@@ -0,0 +1,53 @@
+#include "WoW/Source/WorldClient/WolPostWorld.h"
+
+#include "Engine/Source/WolPost/WolPost.h"
+#include "WoW/Source/UIUtil/Camera.h"
+#include "WoW/Source/Ui/WorldFrame.h"
+#include "WoW/Source/WorldClient/DayNight.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/World.h"
+
+// Not in the original client (World of Legends): the zone / time-of-day grade of the native post pass (wolGradeStrength), brief E4.
+// Licensed under GPL-3.0-only. Reads the same DayNight fields as VolFogWorld.cpp: DNInfo::m_bands (already interpolated by DayNight for the hour and
+// the position), the final fog colour kept by UpdateFog (DayNight::s_volFogSourceFog) and the liquid state of the camera. WolPost::ComputeGrade calls it
+// every frame the grade is on, whether or not wolVolFog is.
+
+namespace {
+    void Rgb(const CImVector& color, float* out) {
+        out[0] = static_cast<float>(color.r);
+        out[1] = static_cast<float>(color.g);
+        out[2] = static_cast<float>(color.b);
+    }
+
+    bool ReadGradeInputs(WolPost::GradeInputs& out) {
+        CGCamera* camera = CGWorldFrame::GetActiveCamera();
+
+        if (!camera) {
+            return false;
+        }
+
+        const DayNight::DNInfo& info = DayNight::g_dnInfo;
+
+        Rgb(info.m_bands.m_ambient, out.ambient);
+        Rgb(info.m_bands.m_diffuse, out.direct);
+        Rgb(info.m_bands.m_skyColors[0], out.skyHigh);
+        Rgb(info.m_bands.m_skyColors[4], out.horizon);
+        Rgb(DayNight::s_volFogSourceFog.m_color, out.fog);
+        out.fogEnd = info.m_bands.m_fogEnd;
+        out.interior = info.m_interiorFogBlend;
+
+        float liquidDepth = 0.0f;
+        out.underwater = World::SceneCamLiquidStatus(&liquidDepth) != 0;
+        out.mapId = World::QueryMapId();
+        out.camPos[0] = camera->m_position.x;
+        out.camPos[1] = camera->m_position.y;
+        out.camPos[2] = camera->m_position.z;
+        out.deltaSec = info.m_deltaSec;
+
+        return true;
+    }
+}
+
+void WolPostWorld::Install() {
+    WolPost::SetGradeProvider(ReadGradeInputs);
+}
