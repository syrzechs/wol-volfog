 {
     float2 uv = (pixel + 0.5 - cArea.xy) / cArea.zw;
@@ -201,6 +224,9 @@ float4 main(float2 pixel : VPOS) : COLOR0
 #endif
 #if TONEMAP == 1
     rgb = Tonemap(rgb, cLook.x, cLook.y);
+#endif
+#if GRADE == 1
+    rgb = Grade(rgb);
 #endif
     return float4(rgb, 1.0);
 }
