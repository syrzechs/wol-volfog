+// Not in the original client (brief E4). wolGradeStrength 0-1 (default 0): colour grading of the post pass from the DayNight bands of the zone and the hour
+// (WolGrade.cpp); 0 is exactly the pass of E1. Read every frame (WolPost::Render), applied at once.
+bool CWorldParam::WolGradeStrengthCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    float strength = 0.0f;
+
+    if (!WolVolFogParseFloat(value, strength) || strength < 0.0f || strength > 1.0f) {
+        ConsoleWrite("wolGradeStrength must be in range 0.0 to 1.0.", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    WolPost::SetGradeStrength(strength);
+
+    if (oldValue && *oldValue) {
+        char buffer[128];
+
+        if (strength > 0.0f) {
+            SStrPrintf(buffer, sizeof(buffer), "wolGradeStrength: %.2f (zone and time-of-day grading from the DayNight light bands)", static_cast<double>(strength));
+        } else {
+            SStrPrintf(buffer, sizeof(buffer), "wolGradeStrength: 0 (off, the picture is the one of the post pass without grading)");
+        }
+
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+    }
+
+    return true;
+}
