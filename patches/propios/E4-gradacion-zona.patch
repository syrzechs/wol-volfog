 #ifndef AA
 #error AA must be 0, 1 or 2
 #endif
+#ifndef GRADE
+#error GRADE must be 0 or 1
+#endif
+
 #ifndef TONEMAP
 #error TONEMAP must be 0 or 1
 #endif
 
 float4 cArea : register(c0); // xy origin of the copied area in the back buffer (pixels, from the top left), zw its size in pixels
 float4 cLook : register(c1); // x exposure (0.5 - 2.0), y saturation (0.5 - 1.5), zw one texel of the copy (1 / width, 1 / height)
+#if GRADE == 1
+float4 cGradeA : register(c2); // xyz gain (tint of the lights), w contrast around 0.45
+float4 cGradeB : register(c3); // xyz lift (tint of the shadows), w saturation
+float4 cGradeC : register(c4); // x invGamma (above 1 it darkens a little: night)
+#endif
 sampler2D sScene : register(s0);
 
 float3 Fetch(float2 uv)
@@ -191,6 +200,20 @@ float3 Tonemap(float3 rgb, float exposure, float saturation)
 }
 #endif
 
+#if GRADE == 1
+// Brief E4: zone / time-of-day grade, in gamma space after the tonemap. The constants come from WolGrade.cpp (derived every frame from the DayNight bands)
+// and already contain the strength: they are 1 + k * delta (gain, contrast, saturation, invGamma) and k * delta (lift), so strength 0 would be the
+// identity (the CPU does not even choose this permutation then, which keeps the pass byte for byte the one of E1).
+float3 Grade(float3 c)
+{
+    float3 x = saturate(c * cGradeA.xyz + cGradeB.xyz * (1.0 - c));
+    x = pow(x, cGradeC.x);
+    x = saturate((x - 0.45) * cGradeA.w + 0.45);
+    float luminance = dot(x, float3(0.2126, 0.7152, 0.0722));
+    return saturate(lerp(luminance.xxx, x, cGradeB.w));
+}
+#endif
