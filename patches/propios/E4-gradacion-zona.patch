diff --git a/b/Engine/Source/WolPost/WolGrade.cpp b/Engine/Source/WolPost/WolGrade.cpp
new file mode 100644
index 0000000..d3de44a
--- /dev/null
+++ b/Engine/Source/WolPost/WolGrade.cpp
@@ -0,0 +1,190 @@
+#include "Engine/Source/WolPost/WolPost.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+// Not in the original client (World of Legends): zone / time-of-day colour grading of the native post pass (wolGradeStrength), brief E4.
+// Licensed under GPL-3.0-only.
+//
+// The grade is derived, every frame, from the colours that the DayNight system of the client has already interpolated for the zone and the hour
+// (DNInfo::m_bands: ambient, diffuse, sky high, sky horizon, fog). Nothing is looked up in a table and nothing is keyed to a zone id, so it follows
+// the hour and the zone continuously, and a zone that Light.dbc paints green or blue is graded green or blue.
+//
+// Model (colours 0..255 sRGB -> linear with ^2.2; lum = Rec. 709; chroma(x) = x / max(lum(x), 1e-3), its deviation from white limited to 0.5 per
+// channel so that an extreme zone does not turn neon):
+//   shadow tint  Ts = chroma(0.6 ambient + 0.4 fog)          light tint  Tl = chroma(0.7 direct + 0.3 horizon)
+//   night        N  = 1 - saturate(lum(direct) / 0.25)        haze        Hz = saturate((800 - fogEnd) / 600)
+// and, for strength k (all of these are 1 + k * delta, which is why the filter below works on the deltas and the strength applies at once):
+//   gain = lerp(1, Tl, 0.25 k)   lift = (Ts - 1) 0.025 k   invGamma = 1 + 0.06 k N
+//   contrast = 1 + k (0.08 (1 - Hz) - 0.06 N)   saturation = 1 + k (0.10 (1 - Hz) - 0.12 N)
+// k is also scaled by (1 - 0.5 interior) and is 0 under water. The shader (WolPost.hlsl, GRADE=1) applies, in gamma space after the tonemap,
+// x = saturate(c * gain + lift * (1 - c)); x = pow(x, invGamma); contrast around 0.45; saturation around the luma.
+// Continuity: the deltas pass through an exponential filter with tau 1.5 s; they jump without the filter on the first frame, on a map change and on
+// a teleport (more than 100 yards in one frame).
+
+namespace {
+    WolPost::GradeInputsProvider s_provider;
+
+    constexpr float kTau = 1.5f;
+
+    // The deltas of the grade at strength 1 with the interior / water factor applied. Only floats: the filter walks it as an array.
+    struct Delta {
+        float gain[3];
+        float lift[3];
+        float invGamma;
+        float contrast;
+        float saturation;
+    };
+
+    struct State {
+        bool valid;
+        Delta delta;
+        uint32_t mapId;
+        float camPos[3];
+    };
+
+    State s_state;
+
+    float Saturate(float v) {
+        return std::min(std::max(v, 0.0f), 1.0f);
+    }
+
+    float ToLinear(float v) {
+        return std::pow(Saturate(v / 255.0f), 2.2f);
+    }
+
+    float Luma(const float* c) {
+        return 0.2126f * c[0] + 0.7152f * c[1] + 0.0722f * c[2];
+    }
+
+    // Linear colour wx * x + wy * y (0..255 sRGB inputs).
+    void Mix(const float* x, float wx, const float* y, float wy, float* out) {
+        for (int i = 0; i < 3; i++) {
+            out[i] = wx * ToLinear(x[i]) + wy * ToLinear(y[i]);
+        }
+    }
+
+    void Chroma(const float* linear, float* out) {
+        float lum = std::max(Luma(linear), 1.0e-3f);
+        float deviation = 0.0f;
+
+        for (int i = 0; i < 3; i++) {
+            out[i] = linear[i] / lum;
+            deviation = std::max(deviation, std::fabs(out[i] - 1.0f));
+        }
+
+        if (deviation > 0.5f) {
+            float scale = 0.5f / deviation;
+
+            for (int i = 0; i < 3; i++) {
+                out[i] = 1.0f + (out[i] - 1.0f) * scale;
+            }
+        }
+    }
+
+    bool ComputeDelta(const WolPost::GradeInputs& in, Delta& out) {
+        float shadowLinear[3];
+        float lightLinear[3];
+        Mix(in.ambient, 0.6f, in.fog, 0.4f, shadowLinear);
+        Mix(in.direct, 0.7f, in.horizon, 0.3f, lightLinear);
+
+        float ts[3];
+        float tl[3];
+        Chroma(shadowLinear, ts);
+        Chroma(lightLinear, tl);
+
+        float directLinear[3] = { ToLinear(in.direct[0]), ToLinear(in.direct[1]), ToLinear(in.direct[2]) };
+        float night = 1.0f - Saturate(Luma(directLinear) / 0.25f);
+        float haze = std::isfinite(in.fogEnd) ? Saturate((800.0f - in.fogEnd) / 600.0f) : 0.0f;
+
+        float environment = in.underwater ? 0.0f : 1.0f - 0.5f * Saturate(in.interior);
+
+        for (int i = 0; i < 3; i++) {
+            out.gain[i] = 0.25f * (tl[i] - 1.0f) * environment;
+            out.lift[i] = 0.025f * (ts[i] - 1.0f) * environment;
+        }
+
+        out.invGamma = 0.06f * night * environment;
+        out.contrast = (0.08f * (1.0f - haze) - 0.06f * night) * environment;
+        out.saturation = (0.10f * (1.0f - haze) - 0.12f * night) * environment;
+
+        const float* all = reinterpret_cast<const float*>(&out);
+
+        for (size_t i = 0; i < sizeof(Delta) / sizeof(float); i++) {
+            if (!std::isfinite(all[i])) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+}
+
+void WolPost::SetGradeProvider(GradeInputsProvider provider) {
+    s_provider = provider;
+}
+
+bool WolPost::ComputeGrade(float strength, GradeParams& out) {
+    out.gain[0] = out.gain[1] = out.gain[2] = 1.0f;
+    out.lift[0] = out.lift[1] = out.lift[2] = 0.0f;
+    out.contrast = 1.0f;
+    out.saturation = 1.0f;
+    out.invGamma = 1.0f;
+
+    if (!(strength > 0.0f) || !s_provider) {
+        s_state.valid = false; // the next frame with a grade starts from its own value, not from an old one
+
+        return false;
+    }
+
+    GradeInputs in;
+    std::memset(&in, 0, sizeof(in));
+    Delta target;
+
+    if (!s_provider(in) || !ComputeDelta(in, target)) {
+        s_state.valid = false;
+
+        return false;
+    }
+
+    float travelled = 0.0f;
+
+    for (int i = 0; i < 3; i++) {
+        float d = in.camPos[i] - s_state.camPos[i];
+        travelled += d * d;
+    }
+
+    bool jump = !s_state.valid || s_state.mapId != in.mapId || travelled > 100.0f * 100.0f;
+
+    if (jump) {
+        s_state.delta = target;
+    } else {
+        // Exponential filter, tau 1.5 s, on the deltas of the grade at strength 1.
+        float dt = std::isfinite(in.deltaSec) ? std::min(std::max(in.deltaSec, 0.0f), 0.25f) : 0.0f;
+        float a = 1.0f - std::exp(-dt / kTau);
+        float* now = reinterpret_cast<float*>(&s_state.delta);
+        const float* goal = reinterpret_cast<const float*>(&target);
+
+        for (size_t i = 0; i < sizeof(Delta) / sizeof(float); i++) {
+            now[i] += (goal[i] - now[i]) * a;
+        }
+    }
+
+    s_state.valid = true;
+    s_state.mapId = in.mapId;
+    std::memcpy(s_state.camPos, in.camPos, sizeof(s_state.camPos));
+
+    const float k = std::min(std::max(strength, 0.0f), 1.0f);
+    const Delta& d = s_state.delta;
+
+    for (int i = 0; i < 3; i++) {
+        out.gain[i] = 1.0f + k * d.gain[i];
+        out.lift[i] = k * d.lift[i];
+    }
+
+    out.invGamma = 1.0f + k * d.invGamma;
+    out.contrast = 1.0f + k * d.contrast;
+    out.saturation = 1.0f + k * d.saturation;
+
+    return true;
+}
