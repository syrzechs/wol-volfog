+++ b/Engine/Source/WolPost/WolPost.h
@@ -0,0 +1,34 @@
+#ifndef ENGINE_SOURCE_WOLPOST_WOLPOST_H
+#define ENGINE_SOURCE_WOLPOST_WOLPOST_H
+
+#include <cstdint>
+
+// Not in the original client (World of Legends): native post-processing pass (anti-aliasing and tonemapping), brief E1.
+// Licensed under GPL-3.0-only. The anti-aliasing shader follows the algorithm of NVIDIA FXAA 3.11 (see Shaders/WolPost/NOTICE.txt).
+
+namespace WolPost {
+    // The CVars of the pass (WorldParam_CVar.cpp validates them and writes here; Render() reads them every frame, so a change applies at once).
+    struct Settings {
+        int32_t aa = 0;             // wolAA 0-2: 0 off, 1 FXAA quality 12, 2 FXAA high quality
+        int32_t tonemap = 0;        // wolTonemap 0-1: filmic tonemapping in linear light
+        float exposure = 1.0f;      // wolExposure 0.5-2.0
+        float saturation = 1.0f;    // wolSaturation 0.5-1.5
+    };
+
+    const Settings& GetSettings();
+    void SetAA(int32_t value);
+    void SetTonemap(int32_t value);
+    void SetExposure(float value);
+    void SetSaturation(float value);
+
+    // True when Render() has something to draw (wolAA or wolTonemap above 0).
+    bool Active();
+
+    // Draws the pass over the world viewport of CGWorldFrame::OnWorldRender, right after VolFog::Render() and before PlayerNameUpdateLate (so the 3D
+    // names and the interface, drawn afterwards, stay sharp and untouched). With wolAA 0 and wolTonemap 0 it returns at once: no scene copy, no draw,
+    // and the scene texture is released. Otherwise it copies the world viewport of the back buffer to a texture and draws one full-screen quad over
+    // it with WolPost.bls (permutation wolAA * 2 + wolTonemap). Independent of wolVolFog.
+    void Render();
+}
+
+#endif
