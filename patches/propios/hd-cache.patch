+// Not in the original client (World of Legends). Texture cache budget in MB: 0 keeps the original behaviour (the
+// calculation of CWorld::UpdateTextureCacheBudget, or gxTextureCacheSize when that is set); 256 - 2048 replaces both with
+// this value, whatever farclip, baseMip or gxTextureCacheSize say. Applied at once (TexSetCacheSize only stores the limit; the
+// textures already resident stay, and the LRU trims at the end of the next scene if the new limit is lower). It is a
+// budget of D3D textures (the resident ones), not an allocation up front. Also written to Logs\gx.log.
+bool CWorldParam::WolTextureCacheMBCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    uint32_t megabytes = 0;
+    bool valid = value && *value;
+
+    for (const char* digit = value; valid && *digit; digit++) {
+        if (*digit < '0' || *digit > '9') {
+            valid = false;
+        } else if (megabytes < 100000) {
+            megabytes = megabytes * 10 + static_cast<uint32_t>(*digit - '0');
+        }
+    }
+
+    if (!valid || (megabytes != 0 && (megabytes < 256 || megabytes > 2048))) {
+        ConsoleWrite("wolTextureCacheMB must be 0 (original) or 256 to 2048 (MB).", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    World::s_wolTexCacheMB = megabytes;
+
+    // The device may not exist yet (the saved value arrives when the CVar is registered): CWorld::UpdateTextureCacheBudget applies it then.
+    if (megabytes) {
+        if (g_theGxDevicePtr) {
+            g_theGxDevicePtr->TexSetCacheSize(megabytes << 20);
+        }
+    } else if (World::s_texCacheOverride) {
+        if (g_theGxDevicePtr) {
+            g_theGxDevicePtr->TexSetCacheSize(World::s_texCacheOverride);
+        }
+    } else {
+        World::s_texCacheDirty = 1;
+    }
+
+    // No message while the CVar is first registered with its default (no previous value, 0).
+    if (megabytes || (oldValue && *oldValue)) {
+        char buffer[256];
+
+        if (megabytes) {
+            SStrPrintf(buffer, sizeof(buffer), "wolTextureCacheMB: texture cache budget %u MB (replaces the automatic budget and gxTextureCacheSize).", megabytes);
+        } else {
+            SStrPrintf(buffer, sizeof(buffer), "wolTextureCacheMB: original (automatic budget, or gxTextureCacheSize if set).");
+        }
+
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+        CGxDevice::Log("%s", static_cast<const char*>(buffer)); // const char*: a char* would pick the va_list overload
+    }
+
+    return true;
+}
