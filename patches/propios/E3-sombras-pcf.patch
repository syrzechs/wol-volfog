+// Not in the original client. Softness of the exterior shadow edges: 0 keeps the original PCF offsets, 1 - 3 widen the kernel
+// (radius about x1.3 / x2 / x2.9 of the original, in texels of the original map size, so it is the same width in yards at any
+// wolShadowMapSize). Applied at once: CShadowCache::InitPcfOffsets rewrites the offsets and they are uploaded every frame, no
+// texture is recreated. See CShadowCache::InitPcfOffsets for the formula.
+bool CWorldParam::WolShadowSoftCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    if (!value || value[0] < '0' || value[0] > '3' || value[1] != '\0') {
+        ConsoleWrite("wolShadowSoft must be 0 (original), 1 (soft), 2 (softer) or 3 (softest).", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    static const char* s_names[4] = { "original", "soft, kernel x1.3", "softer, kernel x2", "softest, kernel x2.9" };
+    uint32_t level = static_cast<uint32_t>(value[0] - '0');
+
+    CShadowCache::s_wolShadowSoft = level;
+
+    // Before the shadow cache starts there is no map size yet: CShadowCache::Init builds the offsets then.
+    if (CShadowCache::s_shadowSize != 0) {
+        CShadowCache::InitPcfOffsets();
+    }
+
+    // No message while the CVar is first registered (no previous value).
+    if (oldValue && *oldValue) {
+        char buffer[256];
+        SStrPrintf(buffer, sizeof(buffer), "wolShadowSoft: %u (%s)", level, s_names[level]);
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+    }
+
+    return true;
+}
