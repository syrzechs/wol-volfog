+// Not in the original client (World of Legends): Logs/files.log, one line per open of a file whose path has "Tileset\\"
+// (terrain textures), to diagnose which name the client asks for and which archive answers. Off by default.
+static volatile int32_t s_wolFileLog = -1;  // -1 = not read yet (environment variable), 0/1 = decided
+
+void Blizzard::Mopaq::WolFileLogSet(int32_t enabled) {
+    s_wolFileLog = enabled ? 1 : 0;
+}
+
+static bool WolFileLogWanted(const char* name) {
+    if (s_wolFileLog < 0) {
+        const char* env = getenv("WOL_FILELOG");
+        s_wolFileLog = (env && env[0] == '1') ? 1 : 0;
+    }
+
+    if (!s_wolFileLog || !name) {
+        return false;
+    }
+
+    static const char kKey[] = "tileset";
+
+    for (const char* p = name; *p; p++) {
+        uint32_t i = 0;
+
+        while (kKey[i] && p[i] && (p[i] | 0x20) == kKey[i]) {
+            i++;
+        }
+
+        if (!kKey[i] && (p[i] == '\\' || p[i] == '/')) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static void WolFileLogLine(const char* name, int32_t found, const char* archiveName, int32_t priority, uint32_t size, uint32_t flags) {
+    // Next to the executable, whatever the working directory is.
+    static FILE* file = []() -> FILE* {
+        char path[520];
+        unsigned long n = GetModuleFileNameA(nullptr, path, 260);
+        while (n > 0 && path[n - 1] != 0x5C && path[n - 1] != 0x2F) {
+            n--;
+        }
+        memcpy(path + n, "Logs/files.log", sizeof("Logs/files.log"));
+        return fopen(path, "a");
+    }();
+
+    if (!file) {
+        return;
+    }
+
+    fprintf(file, "open %s found=%d archive=%s priority=%d size=%u flags=0x%X\n", name, found, archiveName ? archiveName : "-", priority, size, flags);
+    fflush(file);
+}
