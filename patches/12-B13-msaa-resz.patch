+bool VolFog::ReszResolve(IDirect3DDevice9*, IDirect3DTexture9*, IDirect3DStateBlock9*) {
+    return false;
+}
+
+bool VolFog::ReszSelfTest(IDirect3DDevice9*, IDirect3DTexture9*, IDirect3DSurface9*, IDirect3DStateBlock9*, float*, float*) {
+    return false;
+}
+
+#endif
