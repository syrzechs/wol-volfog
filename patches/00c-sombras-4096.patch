+// Not in the original client. Size in texels of the exterior shadow map textures: 0 keeps the original (1024, or 2048 in
+// the MEDIUM and >= HIGH modes), 1024, 2048 or 4096 forces it. The textures are recreated the same way as when
+// extShadowQuality changes: CShadowCache::Update destroys and creates them on the next frame (see CShadowCache::Init).
+bool CWorldParam::WolShadowMapSizeCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    uint32_t size = 0;
+    bool valid = value && *value;
+
+    for (const char* digit = value; valid && *digit; digit++) {
+        if (*digit < '0' || *digit > '9') {
+            valid = false;
+        } else if (size < 100000) {
+            size = size * 10 + static_cast<uint32_t>(*digit - '0');
+        }
+    }
+
+    if (!valid || (size != 0 && size != 1024 && size != 2048 && size != 4096)) {
+        ConsoleWrite("wolShadowMapSize must be 0 (original), 1024, 2048 or 4096.", DEFAULT_COLOR);
+
+        return false;
+    }
+
+    CShadowCache::s_wolShadowMapSize = size;
+    CShadowCache::NotifyTexturesRecreate();
+
+    // No message while the CVar is first registered (no previous value).
+    if (oldValue && *oldValue) {
+        char buffer[256];
+
+        if (size) {
+            SStrPrintf(buffer, sizeof(buffer), "wolShadowMapSize: %u x %u", size, size);
+        } else {
+            SStrPrintf(buffer, sizeof(buffer), "wolShadowMapSize: original");
+        }
+
+        ConsoleWrite(buffer, DEFAULT_COLOR);
+    }
+
+    return true;
+}
