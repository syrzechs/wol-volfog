# cambios-cliente.diff - wol-volfog (World of Legends), 2026-10-20
# What the 11 patches of ./patches change in files OUTSIDE the module (Gx format tables, OnWorldRender in WorldFrame.cpp, the linear fog in
# DayNight::UpdateFog, the CVars). One diff, 16 files, 46 hunks, made on wowdecomp 0e4e9fe plus our other local client patches.
# Context lines come from that tree: on a clean wowdecomp 41 hunks apply and 5 (CVar registration, next to our other wol* CVars) need
# placing by hand (git apply --reject). Lines before the first "diff --git" are ignored by git apply.
# Brief B13 (patch 12): the last sections of this file (CGxDeviceD3d.cpp, CGxDeviceD3d9Ex.cpp, WorldParam_CVar.cpp, again) are the B13 hunks; git apply takes them after the
# sections above, in file order, so apply the whole file or none of it.
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 468c8c4..c2421a6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -84,6 +84,8 @@ add_subdirectory(Engine/Source/SoundEngine)
 add_subdirectory(Engine/Source/SteelseriesMouse)
 add_subdirectory(Engine/Source/Storm)
 add_subdirectory(Engine/Source/Tempest)
+# Not in the original client (World of Legends): native volumetric fog (wolVolFog).
+add_subdirectory(Engine/Source/VolFog)
 add_subdirectory(WoW/Common)
 add_subdirectory(WoW/Source/Battlenet)
 add_subdirectory(WoW/Source/Console)
@@ -105,6 +107,13 @@ add_subdirectory(WoW/Source/WorldClient)
 add_subdirectory(WoW/Source/WowServices)
 add_subdirectory(WoW/Source/WowSvcs)
 add_subdirectory(WoW/Source)
+# Not in the original client (World of Legends): HLSL shaders of the native volumetric fog (wolVolFog), compiled with fxc
+# (Windows SDK) and packed with Python into bin/Win/Data/patch-Z.MPQ; WowClient depends on the VolFogShaders target.
+# OFF skips the whole chain (no fxc or Python needed); the client then has no volumetric fog shaders and wolVolFogDebug does nothing.
+option(WOWDECOMP_VOLFOG "Compile the volumetric fog shaders (fxc) into patch-Z.MPQ" ON)
+if (WOWDECOMP_VOLFOG)
+    add_subdirectory(Shaders/VolFog)
+endif ()
 if (WIN32)
     add_subdirectory(Tools/WowClient)
 endif ()
